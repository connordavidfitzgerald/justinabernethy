---
import "../styles/global.css";
import { Font, type CssVariable, Picture } from "astro:assets";
import headshot from "../assets/images/JAFINALHEADSHOT.jpg";

export interface Props {
    title?: string;
    description?: string;
    preloadImages?: string[];
}

const {
    title = "Justin Abernethy",
    description = "Director and Photographer Based in Toronto.",
    preloadImages = [],
} = Astro.props;
const FONTS: CssVariable[] = ["--font-sans"];
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
        <meta name="author" content="Justin Abernethy" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
        <link rel="dns-prefetch" href="https://cdn.sanity.io" />
        {preloadImages.map((url) => <link rel="preload" as="image" href={url} />)}
        {FONTS.map((font) => <Font cssVariable={font} preload />)}
        <title>{title}</title>
    </head>
    <script is:inline>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            if (savedTheme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <body class="min-h-screen var(--font-sans) uppercase bg-theme">
        <div
            class="fixed top-0 left-0 right-0 h-fit flex flex-row justify-between font-normal text-md px-padding z-10001 pt-padding pb-padding tracking-custom text-white mix-blend-difference"
        >
            <div style="overflow: hidden;">
                <a id="nav-logo" href="/" class="block pl-1 pt-0.5">Justin Abernethy</a>
            </div>
            <div class="flex flex-row gap-20 justify-end pr-1 pt-0.5">
                <div class="flex flex-row gap-padding text-md tracking-[-1%] justify-end">
                    <div style="overflow: hidden;">
                        <h3 id="theme-light" class="cursor-pointer opacity-muted dark:opacity-100">LIGHT</h3>
                    </div>
                    <div style="overflow: hidden;">
                        <h3 id="theme-dark" class="cursor-pointer opacity-100 dark:opacity-muted">DARK</h3>
                    </div>
                </div>
                <div style="overflow: hidden; position: relative;">
                    <a id="nav-info" class="block">
                        <span id="nav-info-label" style="display: block;">Information</span>
                    </a>
                    <span id="nav-info-close" class="cursor-pointer" style="display: block; position: absolute; top: 0; right: 0; white-space: nowrap; visibility: hidden;">Close</span>
                    <span id="nav-info-scroll-top" class="cursor-pointer" style="display: block; position: absolute; top: 0; right: 0; white-space: nowrap; visibility: hidden;">Back to top</span>
                </div>
            </div>
        </div>

        <!-- Info overlay: wipes down from above, z-index below nav (10001) -->
        <div
            id="info-overlay"
            style="position: fixed; inset: 0; z-index: 10000; pointer-events: none;"
            class=""
        >
            <div
                id="info-panel"
                class="bg-theme text-theme absolute inset-0"
                style="opacity: 0;"
            >
                <!-- Desktop layout -->
                <div
                    class="hidden md:grid grid-cols-10 gap-gutter px-padding text-sm leading-[110%] h-screen! items-end"
                    style=""
                >
                    <!-- Left column: text content -->
                    <div class="min-[1350px]:col-span-5 col-span-4 h-full flex flex-col justify-center">
                        <div class="flex flex-col gap-padding w-full h-fit min-[1350px]:grid min-[1350px]:grid-cols-5 min-[1350px]:gap-gutter">
                            <div class="min-[1350px]:col-span-3! flex flex-col gap-padding items-start">
                                <p class="text-nowrap">
                                    Director and Photographer Based in Toronto.<br/><span id="email"class="opacity-muted text-nowrap cursor-pointer">info@justinabernethy.com</span>
                                </p>
                            </div>
                            <div class="min-[1350px]:pt-0 pt-10 flex flex-row gap-10 min-[1350px]:gap-padding min-[1350px]:contents">
                                <div style="overflow: hidden; line-height: 1;">
                                    <a
                                        id="info-reveal-instagram"
                                        class="block cursor-pointer hover:opacity-muted min-[1350px]:col-span-1 min-[1350px]:flex min-[1350px]:justify-end"
                                        style="display: block;"
                                        href="https://www.instagram.com/nethyj/"
                                    >Instagram</a>
                                </div>
                                <div style="overflow: hidden; line-height: 1;">
                                    <a
                                        id="info-reveal-vimeo"
                                        class="block cursor-pointer hover:opacity-muted min-[1350px]:col-span-1 min-[1350px]:flex min-[1350px]:justify-end min-[1350px]:pr-4"
                                        style="display: block;"
                                        href="https://vimeo.com/user96868841"
                                    >Vimeo</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right column: headshot -->
                    <div class="min-[1350px]:col-span-5 col-span-6 h-full flex flex-col justify-end items-end overflow-hidden pr-padding pt-[2.1rem] mb-padding max-h-screen">
                        <div class="h-full max-w-full aspect-5/7 overflow-hidden flex flex-col justify-end pb-padding max-h-screen!" style="max-height: calc(100%);">
                            <Picture
                                src={headshot}
                                alt="Justin Abernethy headshot"
                                class="w-full aspect-5/7 max-h-screen object-cover"
                            />
                        </div>
                    </div>
                </div>

                <!-- Mobile layout: exact same structure as the slider with project 00 -->
                <div class="md:hidden h-full p-padding overflow-hidden">
                    <!-- matches #mobile-slider: h-full relative, acts as positioning context -->
                    <div class="h-full w-full relative">
                        <!-- matches .slider-slide: h-full flex items-center px-10 -->
                        <div class="h-full flex items-center px-10">
                            <Picture
                                src={headshot}
                                alt="Justin Abernethy headshot"
                                class="w-full object-cover block"
                                style="aspect-ratio: 5/7;"
                            />
                        </div>
                        <!-- matches #center-info: absolute top-1/2 left-0 right-0.
                             No hardcoded pointer-events here: links inherit the
                             #info-overlay container's state (none when closed,
                             auto when open) so they only respond while open. -->
                        <div class="absolute top-1/2 left-0 right-0 flex flex-row justify-between items-start text-white mix-blend-difference uppercase tracking-custom text-sm font-normal">
                            <div class="leading-[110%] w-[75%]">
                                <span style="display:block">Director and Photographer from Toronto.</span>
                                <a href="mailto:info@justinabernethy.com" style="display:block;opacity:0.5">info@justinabernethy.com</a>
                                <span style="display:flex;gap:2.5rem;padding-top:4rem;">
                                    <a href="https://www.instagram.com/nethyj/">Instagram</a>
                                    <a href="https://vimeo.com/user96868841">Vimeo</a>
                                </span>
                            </div>
                            <span class="leading-[110%]">000</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <slot />

        <script>
            import Lenis from 'lenis';
            import gsap from 'gsap';

            (window as any).gsap = gsap;

            const lenis = new Lenis({
                duration: 0.8,
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                orientation: 'vertical',
                smoothWheel: true,
            });

            function raf(time: number) {
                lenis.raf(time);
                requestAnimationFrame(raf);
            }
            requestAnimationFrame(raf);

            (window as any).lenis = lenis;

            const root = document.documentElement;
            const lightBtn = document.getElementById('theme-light');
            const darkBtn = document.getElementById('theme-dark');

            function updateButtonStates() {
                const isDark = root.classList.contains('dark');
                if (lightBtn && darkBtn) {
                    lightBtn.style.opacity = isDark ? 'var(--opacity-muted)' : '1';
                    darkBtn.style.opacity = isDark ? '1' : 'var(--opacity-muted)';
                }
            }
            updateButtonStates();

            lightBtn?.addEventListener('click', () => {
                root.classList.remove('dark');
                localStorage.setItem('theme', 'light');
                updateButtonStates();
                window.dispatchEvent(new CustomEvent('themechange', { detail: 'light' }));
            });

            darkBtn?.addEventListener('click', () => {
                root.classList.add('dark');
                localStorage.setItem('theme', 'dark');
                updateButtonStates();
                window.dispatchEvent(new CustomEvent('themechange', { detail: 'dark' }));
            });

            // ─── Info overlay ─────────────────────────────────────────────────────

            const overlay      = document.getElementById('info-overlay')!;
            const panel        = document.getElementById('info-panel')!;
            const navInfo      = document.getElementById('nav-info')!;
            const navInfoLabel = document.getElementById('nav-info-label')!;
            const navInfoClose     = document.getElementById('nav-info-close')!;
            const navInfoScrollTop = document.getElementById('nav-info-scroll-top')!;
            let overlayOpen    = false;
            let footerVisible  = false;
            let labelTl: gsap.core.Timeline | null = null;
            let mobileInfoSlideActive = false;

            window.addEventListener('mobile-info-slide', (e: any) => {
                if (window.innerWidth >= 768) return;
                mobileInfoSlideActive = e.detail.active;
                if (!overlayOpen) swapLabel(mobileInfoSlideActive ? 'close' : 'info');
            });

            // Initial states
            gsap.set(panel,            { opacity: 0 });
            gsap.set(navInfoClose,     { yPercent: 110 });
            gsap.set(navInfoScrollTop, { yPercent: 110 });

            // Slide in the requested label, slide everything else out.
            // state: 'info' | 'close' | 'scroll-top'
            function swapLabel(state: 'info' | 'close' | 'scroll-top') {
                if (labelTl) labelTl.kill();
                labelTl = gsap.timeline();
                const targets = [
                    { el: navInfoLabel,     active: state === 'info' },
                    { el: navInfoClose,     active: state === 'close' },
                    { el: navInfoScrollTop, active: state === 'scroll-top' },
                ];
                // Slide all outgoing labels out simultaneously
                for (const { el, active } of targets) {
                    if (!active) {
                        labelTl.to(el, { yPercent: 110, duration: 0.22, ease: 'power3.in' }, 0);
                    }
                }
                // Slide the incoming label in after outgoing finishes
                for (const { el, active } of targets) {
                    if (active) {
                        el.style.visibility = 'visible';
                        labelTl.to(el, { yPercent: 0, duration: 0.22, ease: 'power3.out' }, '>+0.05');
                    }
                }
            }

            function openInfo() {
                if (overlayOpen) return;
                overlayOpen = true;
                overlay.style.pointerEvents = 'auto';
                document.body.style.overflow = 'hidden';
                swapLabel('close');

                gsap.to(panel, { opacity: 1, duration: 0.35, ease: 'power3.out' });
            }

            function closeInfo() {
                if (!overlayOpen) return;
                overlayOpen = false;
                document.body.style.overflow = '';
                swapLabel(footerVisible ? 'scroll-top' : 'info');

                gsap.to(panel, {
                    opacity: 0,
                    duration: 0.3,
                    ease: 'power3.in',
                    onComplete: () => {
                        overlay.style.pointerEvents = 'none';
                    }
                });
            }

            
            navInfo.addEventListener('click', (e: MouseEvent) => {
                e.preventDefault();
                if (window.innerWidth >= 768) {
                    if (footerVisible) {
                        ((window as any).lenis ?? window).scrollTo(0, { duration: 2.4, easing: (t: number) => 1 - Math.pow(1 - t, 10) });
                    } else if (overlayOpen) {
                        closeInfo();
                    } else {
                        openInfo();
                    }
                } else {
                    if (overlayOpen) closeInfo();
                    else if (mobileInfoSlideActive) (window as any).__mobileGoNextSlide?.();
                    else openInfo();
                }
            });

            navInfoClose.addEventListener('click', () => {
                closeInfo();
            });

            navInfoScrollTop.addEventListener('click', () => {
                if (window.innerWidth >= 768) {
                    ((window as any).lenis ?? window).scrollTo(0, { duration: 1.8, easing: (t: number) => 1 - Math.pow(1 - t, 3) });
                }
            });

            document.addEventListener('keydown', (e: KeyboardEvent) => {
                if (e.key === 'Escape' && overlayOpen) closeInfo();
            });

            // ─── Footer visibility observer ───────────────────────────────────────
            const desktopFooter = document.getElementById('desktop-footer');
            if (desktopFooter) {
                const footerObserver = new IntersectionObserver((entries) => {
                    for (const entry of entries) {
                        footerVisible = entry.isIntersecting;
                        if (!overlayOpen) {
                            swapLabel(footerVisible ? 'scroll-top' : 'info');
                        }
                    }
                }, { threshold: 0.05 });
                footerObserver.observe(desktopFooter);
            }
        </script>
    </body>
</html>

---
import "../styles/global.css";
import { Font, type CssVariable, Picture } from "astro:assets";
import headshot from "../assets/images/JAFINALHEADSHOT.jpg";

export interface Props {
    title: string;
    description?: string;
    preloadImages?: string[];
}

const {
    title,
    description = "Astro + Tailwind + Sanity + Mux + GSAP + Cloudflare",
    preloadImages = [],
} = Astro.props;
const FONTS: CssVariable[] = ["--font-sans"];
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
        <link rel="dns-prefetch" href="https://cdn.sanity.io" />
        {preloadImages.map((url) => <link rel="preload" as="image" href={url} />)}
        {FONTS.map((font) => <Font cssVariable={font} preload />)}
        <title>{title}</title>
    </head>
    <script is:inline>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            if (savedTheme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <body class="min-h-screen var(--font-sans) uppercase bg-theme">
        <div
            class="fixed top-0 left-0 right-0 h-fit flex flex-row justify-between font-normal text-md px-padding z-10001 pt-padding pb-padding tracking-custom text-white mix-blend-difference"
        >
            <div style="overflow: hidden;">
                <a id="nav-logo" href="/" class="block pl-1 pt-0.5">Justin Abernethy</a>
            </div>
            <div class="flex flex-row gap-20 justify-end pr-1 pt-0.5">
                <div class="flex flex-row gap-padding text-md tracking-[-1%] justify-end">
                    <div style="overflow: hidden;">
                        <h3 id="theme-light" class="cursor-pointer opacity-muted dark:opacity-100">LIGHT</h3>
                    </div>
                    <div style="overflow: hidden;">
                        <h3 id="theme-dark" class="cursor-pointer opacity-100 dark:opacity-muted">DARK</h3>
                    </div>
                </div>
                <div style="overflow: hidden; position: relative;">
                    <a id="nav-info" href="/information" class="block">
                        <span id="nav-info-label" style="display: block;">Information</span>
                    </a>
                    <span id="nav-info-close" class="cursor-pointer" style="display: block; position: absolute; top: 0; right: 0; white-space: nowrap;">Close</span>
                    <span id="nav-info-scroll-top" class="cursor-pointer" style="display: block; position: absolute; top: 0; right: 0; white-space: nowrap;">Back to top</span>
                </div>
            </div>
        </div>

        <!-- Info overlay: wipes down from above, z-index below nav (10001) -->
        <div
            id="info-overlay"
            style="position: fixed; inset: 0; z-index: 10000; pointer-events: none;"
        >
            <div
                id="info-panel"
                class="bg-theme text-theme absolute inset-0"
                style="clip-path: inset(0% 0% 100% 0%);"
            >
                <!-- Desktop layout -->
                <div
                    class="hidden md:grid grid-cols-10 gap-gutter px-padding h-full text-sm leading-[110%]"
                    style="padding-top: calc(var(--spacing-padding) * 2 + 1em);"
                >
                    <!-- Left column: text content -->
                    <div class="min-[1350px]:col-span-5 col-span-4 h-full flex flex-col justify-center">
                        <div class="flex flex-col gap-padding w-full h-fit min-[1350px]:grid min-[1350px]:grid-cols-5 min-[1350px]:gap-gutter">
                            <div class="min-[1350px]:col-span-3! flex flex-col gap-padding items-start">
                                <p class="text-nowrap">
                                    Director and Photographer Based in Toronto.<br/><span id="email"class="opacity-muted text-nowrap cursor-pointer">info@justinabernethy.com</span>
                                </p>
                            </div>
                            <div class="min-[1350px]:pt-0 pt-10 flex flex-row gap-10 min-[1350px]:gap-padding min-[1350px]:contents">
                                <div style="overflow: hidden; line-height: 1;">
                                    <span
                                        id="info-reveal-instagram"
                                        class="block cursor-pointer hover:opacity-muted min-[1350px]:col-span-1 min-[1350px]:flex min-[1350px]:justify-end"
                                        style="display: block;"
                                    >Instagram</span>
                                </div>
                                <div style="overflow: hidden; line-height: 1;">
                                    <span
                                        id="info-reveal-vimeo"
                                        class="block cursor-pointer hover:opacity-muted min-[1350px]:col-span-1 min-[1350px]:flex min-[1350px]:justify-end min-[1350px]:pr-4"
                                        style="display: block;"
                                    >Vimeo</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right column: headshot with reveal cover -->
                    <div class="min-[1350px]:col-span-5 col-span-6 flex flex-row justify-end items-end h-full">
                        <div class="w-full h-screen px-padding py-3 flex flex-col justify-end items-end overflow-clip" style="position: relative;">
                            <div class="w-full">
                                <Picture
                                    src={headshot}
                                    alt="Justin Abernethy headshot"
                                    class="aspect-5/7 w-full h-auto object-cover min-h-157 max-h-[90vh]"
                                />
                            </div>
                            <div
                                id="info-headshot-cover"
                                style="position: absolute; inset: 0; background: var(--bg-primary); z-index: 5;"
                            ></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <slot />

        <script>
            import Lenis from 'lenis';
            import gsap from 'gsap';

            (window as any).gsap = gsap;

            const lenis = new Lenis({
                duration: 0.8,
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                orientation: 'vertical',
                smoothWheel: true,
            });

            function raf(time: number) {
                lenis.raf(time);
                requestAnimationFrame(raf);
            }
            requestAnimationFrame(raf);

            (window as any).lenis = lenis;

            const root = document.documentElement;
            const lightBtn = document.getElementById('theme-light');
            const darkBtn = document.getElementById('theme-dark');

            function updateButtonStates() {
                const isDark = root.classList.contains('dark');
                if (lightBtn && darkBtn) {
                    lightBtn.style.opacity = isDark ? 'var(--opacity-muted)' : '1';
                    darkBtn.style.opacity = isDark ? '1' : 'var(--opacity-muted)';
                }
            }
            updateButtonStates();

            lightBtn?.addEventListener('click', () => {
                root.classList.remove('dark');
                localStorage.setItem('theme', 'light');
                updateButtonStates();
                window.dispatchEvent(new CustomEvent('themechange', { detail: 'light' }));
            });

            darkBtn?.addEventListener('click', () => {
                root.classList.add('dark');
                localStorage.setItem('theme', 'dark');
                updateButtonStates();
                window.dispatchEvent(new CustomEvent('themechange', { detail: 'dark' }));
            });

            // ─── Info overlay ─────────────────────────────────────────────────────

            const overlay      = document.getElementById('info-overlay')!;
            const panel        = document.getElementById('info-panel')!;
            const navInfo      = document.getElementById('nav-info')!;
            const navInfoLabel = document.getElementById('nav-info-label')!;
            const navInfoClose     = document.getElementById('nav-info-close')!;
            const navInfoScrollTop = document.getElementById('nav-info-scroll-top')!;
            const revealEls    = (
                ['info-reveal-bio', 'info-reveal-email', 'info-reveal-instagram', 'info-reveal-vimeo']
                    .map(id => document.getElementById(id))
                    .filter(Boolean)
            ) as HTMLElement[];
            const headshotCover = document.getElementById('info-headshot-cover') as HTMLElement | null;

            let overlayOpen    = false;
            let footerVisible  = false;
            let labelTl: gsap.core.Timeline | null = null;

            // Initial states
            gsap.set(panel,            { clipPath: 'inset(0% 0% 100% 0%)' });
            gsap.set(revealEls,        { clipPath: 'inset(0% 0% 100% 0%)' });
            gsap.set(headshotCover,    { clipPath: 'inset(0% 0% 0% 0%)' });
            gsap.set(navInfoClose,     { yPercent: 110 });
            gsap.set(navInfoScrollTop, { yPercent: 110 });

            // Slide in the requested label, slide everything else out.
            // state: 'info' | 'close' | 'scroll-top'
            function swapLabel(state: 'info' | 'close' | 'scroll-top') {
                if (labelTl) labelTl.kill();
                labelTl = gsap.timeline();
                const targets = [
                    { el: navInfoLabel,     active: state === 'info' },
                    { el: navInfoClose,     active: state === 'close' },
                    { el: navInfoScrollTop, active: state === 'scroll-top' },
                ];
                for (const { el, active } of targets) {
                    if (active) {
                        labelTl.to(el, { yPercent: 0,   duration: 0.22, ease: 'power3.out' }, '-=0.05');
                    } else {
                        labelTl.to(el, { yPercent: 110, duration: 0.22, ease: 'power3.in'  }, 0);
                    }
                }
            }

            function openInfo() {
                if (overlayOpen) return;
                overlayOpen = true;
                overlay.style.pointerEvents = 'auto';
                document.body.style.overflow = 'hidden';
                swapLabel('close');

                // Background appears instantly
                gsap.set(panel, { clipPath: 'inset(0% 0% 0% 0%)' });

                // Text elements: staggered clip-path reveal top → bottom
                gsap.to(revealEls, {
                    clipPath: 'inset(0% 0% 0% 0%)',
                    duration: 0.6,
                    ease: 'power3.out',
                    stagger: 0.08,
                });

                // Headshot: clip the cover away from top so the image is revealed top → bottom
                gsap.to(headshotCover, {
                    clipPath: 'inset(100% 0% 0% 0%)',
                    duration: 1.0,
                    ease: 'power2.out',
                    delay: 0.15,
                });
            }

            function closeInfo() {
                if (!overlayOpen) return;
                overlayOpen = false;
                document.body.style.overflow = '';
                swapLabel(footerVisible ? 'scroll-top' : 'info');

                const tl = gsap.timeline({
                    onComplete: () => {
                        // Reset to initial state; panel hides instantly after elements are gone
                        gsap.set(panel,         { clipPath: 'inset(0% 0% 100% 0%)', });
                        gsap.set(revealEls,     { clipPath: 'inset(0% 0% 100% 0%)' });
                        gsap.set(headshotCover, { clipPath: 'inset(0% 0% 0% 0%)' });
                        overlay.style.pointerEvents = 'none';

                    }
                });}


            navInfo.addEventListener('click', (e: MouseEvent) => {
                if (window.innerWidth >= 768) {
                    e.preventDefault();
                    if (footerVisible) {
                        ((window as any).lenis ?? window).scrollTo(0, { duration: 1.2, easing: (t: number) => 1 - Math.pow(1 - t, 3) });
                    } else if (overlayOpen) {
                        closeInfo();
                    } else {
                        openInfo();
                    }
                }
                // mobile: falls through to normal /information navigation
            });

            navInfoClose.addEventListener('click', () => {
                if (window.innerWidth >= 768) closeInfo();
            });

            navInfoScrollTop.addEventListener('click', () => {
                if (window.innerWidth >= 768) {
                    ((window as any).lenis ?? window).scrollTo(0, { duration: 1.2, easing: (t: number) => 1 - Math.pow(1 - t, 3) });
                }
            });

            document.addEventListener('keydown', (e: KeyboardEvent) => {
                if (e.key === 'Escape' && overlayOpen) closeInfo();
            });

            // ─── Footer visibility observer ───────────────────────────────────────
            const desktopFooter = document.getElementById('desktop-footer');
            if (desktopFooter) {
                const footerObserver = new IntersectionObserver((entries) => {
                    for (const entry of entries) {
                        footerVisible = entry.isIntersecting;
                        if (!overlayOpen) {
                            swapLabel(footerVisible ? 'scroll-top' : 'info');
                        }
                    }
                }, { threshold: 0.05 });
                footerObserver.observe(desktopFooter);
            }
        </script>
    </body>
</html>

---
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import headshot from "../assets/images/JAFINALHEADSHOT.jpg"
---

<Layout title="Justin Abernethy — Information">
    <div id="mobile-info"class="h-screen md:hidden flex flex-col p-padding text-sm leading-[110%]">
        <div class="h-full flex flex-col grow justify-center">
            <div class="flex flex-row items-start justify-start">
                    <p class="text-nowrap pb-10">
                        Director and Photographer Based in Toronto.<br/><span id="email"class="opacity-muted text-nowrap cursor-pointer">info@justinabernethy.com</span>
                    </p>
                </div>
            <div class="grid grid-cols-10 gap-gutter">
                <a href="https://www.instagram.com/nethyj/" id="footer-button" class="col-span-3 flex flex-row justify-start items-start hover:opacity-muted cursor-pointer">Instagram</a>
                <a href="https://vimeo.com/user96868841" id="footer-button" class="col-span-3 flex flex-row justify-start items-start hover:opacity-muted cursor-pointer">Vimeo</a>
            </div>
        </div>
        <div class="col-span-10 flex flex-row justify-end items-end h-full">
            <div class="w-full">
                <Picture src={headshot} alt="Justin Abernethy headshot" class="w-full h-auto"></Picture>
            </div>
        </div>
    </div>

    <div id="desktop-info" class="h-screen min-h-220 hidden md:grid! grid-cols-10! gap-gutter p-padding text-sm leading-[110%]">
        <div class="min-[1100px]:col-span-5 col-span-4 h-full flex flex-col justify-center">
            <div class="flex flex-col gap-padding w-full h-fit min-[1100px]:grid min-[1100px]:grid-cols-5 min-[1100px]:gap-gutter">
                <div class="min-[1100px]:col-span-3! flex flex-row items-start justify-start">
                    <p class="text-nowrap">
                        Director and Photographer Based in Toronto.<br/><span id="email"class="opacity-muted text-nowrap cursor-pointer">info@justinabernethy.com</span>
                    </p>
                </div>
                <div class="min-[1100px]:pt-0 pt-10 flex flex-row gap-10 min-[1100px]:gap-padding min-[1100px]:contents ">
                    <a href="https://www.instagram.com/nethyj/" id="footer-button" class="min-[1100px]:col-span-1 min-[1100px]:justify-end flex flex-row justify-start items-start hover:opacity-muted cursor-pointer">Instagram</a>
                    <a href="https://vimeo.com/user96868841" id="footer-button" class="min-[1100px]:col-span-1 min-[1100px]:justify-end min-[1100px]:pr-4  flex flex-row justify-start  items-start hover:opacity-muted cursor-pointer">Vimeo</a>
                </div>
            </div>
        </div>
        <div class="min-[1100px]:col-span-5 col-span-6 flex flex-row justify-end items-end h-full">
            <div class="w-full h-screen px-padding py-3">
                <Picture src={headshot} alt="Justin Abernethy headshot" class="aspect-5/7 w-full h-full object-cover min-w-165"></Picture>
            </div>
        </div>
    </div>



</Layout>

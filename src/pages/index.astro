---
import Layout from '../layouts/Layout.astro';
import Preloader from '../components/Preloader.astro';
import { Picture } from 'astro:assets';
import { MuxPlayer } from '@mux/mux-player-astro';
import { loadQuery } from '../sanity/lib/loadQuery.ts';
import { urlForImage } from '../sanity/lib/url-for-image.ts';
import { sanityClient } from 'sanity:client';
import headshot from "../assets/images/JAFINALHEADSHOT.jpg"

const PROJECTS_QUERY = `*[_type == "project"] | order(index desc) {
 _id,
  name,
  type,
  index,
  thumbnail {
      ...,
      asset-> {
        _id,
        url,
        metadata {
          dimensions,
          lqip
        }
      }
    },
  imageGallery[] {
      _key,
      asset-> {
        _id,
        url,
        metadata {
          dimensions,
          lqip
        }
      }
    },
  muxID,
}`;

const { data: projects } = await loadQuery({ query: PROJECTS_QUERY });

const ROW_SIZE = 5;

// Chunk into rows of ROW_SIZE
const rows = Array.from({ length: Math.ceil(projects.length / ROW_SIZE) }, (_, i) =>
  projects.slice(i * ROW_SIZE, i * ROW_SIZE + ROW_SIZE)
);

// aspect is h/w — portrait 2/3 = 1.5, landscape 16/9 ≈ 0.5625
function getAspect(project: (typeof projects)[number]): number {
  return project.muxID && !project.thumbnail?.asset ? 9 / 16 : 7 / 5;
}

// Pre-compute all image URLs for client-side use
const projectsWithUrls = projects.map(project => ({
  ...project,
  thumbnailUrl: project.thumbnail?.asset ? `${urlForImage(project.thumbnail).url()}?auto=format` : null,
  galleryUrls: project.imageGallery?.filter((img: any) => img?.asset).map((img: any) => ({
    url: `${urlForImage(img).url()}?auto=format`,
    _key: img._key
  })) || []
}));

// Thumbnails sorted ascending by index for the preloader
const preloaderThumbnails = projectsWithUrls
    .slice()
    .sort((a: any, b: any) => a.index - b.index)
    .map((p: any) => p.thumbnailUrl)
    .filter(Boolean) as string[];

// Info slide (project 00) for mobile slider
const infoSlide = {
  _id: '__info__',
  name: null,
  type: null,
  index: 0,
  thumbnailUrl: headshot.src,
  galleryUrls: [] as { url: string; _key: string }[],
};

const allSlides = [...projectsWithUrls, infoSlide];

// Extended list for mobile slider's infinite loop:
// [clone-of-last, ...real-items, clone-of-first]
const extendedProjects =
  allSlides.length > 0
    ? [allSlides[allSlides.length - 1], ...allSlides, allSlides[0]]
    : [];
---

<style>
  /* GPU optimization hints for frequently animated elements */
  .gallery-row-wrapper {
    will-change: transform;
    contain: layout style;
  }
  .gallery-item {
    will-change: flex-grow;
    contain: layout style;
  }
  .gallery-item-cover {
    will-change: transform;
  }
  .preview-item {
    will-change: opacity;
  }
  /* Reduce paint areas */
  #gallery-container {
    contain: layout style;
  }
</style>

<Layout title="Justin Abernethy">
  <Preloader thumbnails={preloaderThumbnails} />
  <main class="hidden md:block p-padding bg-theme text-theme">
    <section class="relative">
      {projects.length === 0 && <p class="text-gray-400">No projects found.</p>}

      <!-- Gallery Container -->
      <div id="gallery-container" class="flex flex-col gap-0" style="visibility: hidden; opacity: 0;">
        {
          rows.map((row, rowIndex) => (
            <div class="gallery-row-wrapper relative" data-wrapper={rowIndex}>
              <div
                class="gallery-row absolute inset-x-0 bottom-0 flex gap-0 items-end"
                data-row={rowIndex}
              >
                {row.map((project, projectIndex) => {
                  const aspect = getAspect(project);
                  const globalIndex = rowIndex * ROW_SIZE + projectIndex;
                  return (
                    <div
                      class="gallery-item flex flex-col gap-padding min-w-0 px-padding-half cursor-pointer relative overflow-hidden"
                      style="flex: 1 1 0%"
                      data-aspect={aspect}
                      data-row={rowIndex}
                      data-global-index={globalIndex}
                      data-project-id={project._id}
                    >
                      {/* Cover overlay for animation */}
                      <div class="gallery-item-cover absolute -inset-1 bg-theme z-10 pointer-events-none" style="transform: translateY(100%)"></div>

                      {project.muxID && !project.thumbnail?.asset ? (
                        <MuxPlayer
                          playbackId={project.muxID}
                          class="item-media w-full object-cov   er aspect-16/9"
                          style={{ '--controls': 'none' }}
                          muted
                          loop
                          data-flip-id={`media-${project._id}`}
                        />
                      ) : (
                        <img
                          src={`${urlForImage(project.thumbnail).url()}?auto=format`}
                          alt={project.name}
                          class="item-media w-full object-cover"
                          style="aspect-ratio: 5/7"
                          data-flip-id={`media-${project._id}`}
                        />
                      )}
                      <div id="item-name-type" class="item-name-type flex flex-row justify-between w-full relative overflow-clip font-normal tracking-custom -mt-0 pb-padding">
                        <div class="absolute z-0 mt-0 h-full flex flex-col gap-0 project-title">
                          <h3 class="text-sm leading-[100%] tracking-custom whitespace-nowrap">{project.name}</h3>
                        </div>
                        <div class="title-fade-overlay absolute inset-0 h-full w-full z-1 pointer-events-none opacity-0 gradient-fade"></div>
                        <div class="flex flex-col gap-0 items-end grow z-2">
                          <p class="text-sm leading-[100%] tracking-custom flex">{project.index}</p>
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          ))
        }
      </div>

      <!-- Project Detail Section (hidden initially, in document flow) -->
      <div id="project-detail" class="hidden z-20">
        <div class="w-full flex pb-padding">
          <div class="grid grid-cols-10 gap-padding w-full">
            <!-- Left Sidebar -->
            <div class="col-span-2 max-[1100px]:col-span-3 flex flex-col h-full min-h-screen">
              <div class="sticky top-0 h-screen min-h-200 w-full flex flex-col pb-padding">
                <!-- Preview container: grows into remaining space and centres itself -->
                <div class="flex-1 flex items-center">
                <div class="project-preview w-[75%]">
                  <div class="relative w-full" style="aspect-ratio: 4/5">
                    <div class="grid absolute inset-0" id="detail-preview-grid">
                      {projectsWithUrls.map((project) => (
                        <div
                          class="preview-item opacity-0 col-start-1 row-start-1 flex items-center"
                          data-preview-id={project._id}
                        >
                          {project.muxID && !project.thumbnailUrl ? (
                            <MuxPlayer
                              playbackId={project.muxID}
                              class="w-full object-cover aspect-video"
                              style={{ '--controls': 'none' }}
                              muted
                              loop
                            />
                          ) : project.thumbnailUrl ? (
                            <img
                              src={project.thumbnailUrl}
                              alt={project.name}
                              class="w-full object-cover"
                              style="aspect-ratio: 4/5"
                            />
                          ) : null}
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
                </div>

                <!-- Project list -->
                <div id="project-list-container" class="project-list-container">
                  <div class="project-list flex flex-col justify-end gap-0 text-sm uppercase tracking-custom leading-[115%] font-normal">
                    {projectsWithUrls.map((project) => (
                      <div
                        class="detail-list-item flex flex-row gap-padding cursor-pointer opacity-muted"
                        data-project-id={project._id}
                      >
                        <p class="min-w-4.5">{String(project.index).padStart(3, '0')}</p>
                        <p>{project.name}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <!-- Right Content - Image Gallery -->
            <div class="col-span-8 max-[1100px]:col-span-7 flex flex-col gap-padding">
              <div id="detail-image-gallery" class="grid grid-cols-2 max-[1100px]:grid-cols-1 grid-flow-row gap-padding w-full">
                <!-- Images will be populated dynamically -->
              </div>
            </div>
          </div>
        </div>
        <!-- Scroll back hint -->
        <div id="scroll-back-hint" class="fixed inset-0 z-30 bg-theme flex flex-col justify-center items-center text-sm uppercase tracking-custom font-normal select-none pointer-events-none" style="opacity: 0;">
          <div class="relative">
            <span class="opacity-[var(--opacity-muted)]">scroll to go back to projects</span>
            <span id="scroll-back-fill" class="absolute inset-0 overflow-hidden whitespace-nowrap" style="clip-path: inset(0 100% 0 0);">scroll to go back to projects</span>
          </div>
        </div>
      </div>

      <div id="single-view-overlay" class="fixed inset-0 z-[10000] bg-theme hidden opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="h-screen w-full grid! grid-cols-20 gap-padding bg-theme text-theme text-sm tracking-custom uppercase relative px-padding">

          <!-- Left Controls (initially hidden) -->
          <div class="col-span-3 h-full w-full flex flex-row items-center justify-between pr-padding">
            <a id="overlay-exit" class="overlay-nav opacity-muted hover:opacity-100 cursor-pointer ">Exit</a>
            <a id="overlay-prev" class="overlay-nav opacity-100 cursor-pointer hover:opacity-muted">Previous</a>
          </div>

          <!-- Center Media (initially hidden/scaled) -->
          <div class="col-span-14 h-screen w-full flex flex-row justify-center items-center overflow-clip">
            <div id="overlay-media-container" class="w-full h-full flex items-center justify-center opacity-0">
              <!-- Media injected via JS -->
            </div>
          </div>

          <!-- Right Controls (initially hidden) -->
          <div class="col-span-3 col-start-18 h-full w-full flex flex-row items-center justify-between pl-padding">
            <a id="overlay-next" class="overlay-nav opacity-100 cursor-pointer hover:opacity-muted">Next</a>
            <p id="overlay-pagination" class="opacity-100 overlay-nav">1/5</p>
          </div>
        </div>

        <!-- Mux custom controls (moved into the video wrapper at render time) -->
        <div
          id="overlay-mux-controls"
          class="absolute bottom-0 left-0 right-0 z-50 px-padding py-padding flex flex-row justify-between items-center gap-4 text-white mix-blend-difference text-sm uppercase tracking-custom font-medium opacity-0 pointer-events-none transition-opacity duration-200"
        >
          <div class="flex flex-row gap-4 pointer-events-auto items-center">
            <span data-mux-ctl="playpause" class="cursor-pointer hover:opacity-70">PLAY</span>

            <span data-mux-ctl="mute" class="cursor-pointer hover:opacity-70">UNMUTE</span>

          </div>

          <div data-mux-ctl="timeline" class="flex-1 relative h-3 cursor-pointer pointer-events-auto select-none touch-none">
            <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-px bg-white"></div>
            <div data-mux-ctl="thumb" class="absolute top-1/2 -translate-x-1/2 -translate-y-1/2 w-[5px] h-[5px] rounded-full bg-white" style="left: 0%"></div>
          </div>
          <span class="inline-flex gap-1 tabular-nums">
            <span data-mux-ctl="current">00:00</span><span>/</span><span data-mux-ctl="duration">00:00</span>
          </span>
           <span data-mux-ctl="fullscreen" class="cursor-pointer hover:opacity-70 hidden md:inline">FULLSCREEN</span>
        </div>
      </div>
    </section>
    <div class="h-100"></div>
    <div id="desktop-footer" class="h-screen min-h-220 grid! grid-cols-10! gap-gutter text-sm leading-[110%]" style="visibility: hidden; opacity: 0;">
        <div class="min-[1350px]:col-span-5 col-span-4 h-full flex flex-col justify-center">
            <div class="flex flex-col gap-padding w-full h-fit min-[1350px]:grid min-[1350px]:grid-cols-5 min-[1350px]:gap-gutter">
                <div class="min-[1350px]:col-span-3! flex flex-row items-start justify-start">
                    <p class="text-nowrap">
                        Director and Photographer Based in Toronto.<br/><span id="email"class="opacity-muted text-nowrap cursor-pointer">info@justinabernethy.com</span>
                    </p>
                </div>
                <div class="min-[1350px]:pt-0 pt-10 flex flex-row gap-10 min-[1350px]:gap-padding min-[1350px]:contents ">
                    <div id="footer-button" class="min-[1350px]:col-span-1 min-[1350px]:justify-end flex flex-row justify-start items-start hover:opacity-muted cursor-pointer">Instagram</div>
                    <div id="footer-button" class="min-[1350px]:col-span-1 min-[1350px]:justify-end min-[1350px]:pr-4  flex flex-row justify-start  items-start hover:opacity-muted cursor-pointer">Vimeo</div>
                </div>
            </div>
        </div>
        <div class="min-[1350px]:col-span-5 col-span-6 flex flex-row justify-end items-end h-full">
            <div class="w-full h-screen px-padding py-3 flex flex-col justify-end items-end overflow-clip">
                <Picture src={headshot} alt="Justin Abernethy headshot" class="aspect-5/7 w-full h-auto object-cover min-h-157 max-h-[90vh]"></Picture>
            </div>
        </div>
    </div>
  </main>

  <!-- ────────────────────────────── Mobile root ────────────────────────────── -->
  <div class="md:hidden fixed inset-0 z-50 bg-theme text-theme overflow-hidden p-padding">
    <div
      id="mobile-slider"
      class="h-full w-full relative overflow-hidden touch-none select-none"
      data-slide-count={allSlides.length}
    >
      <div
        id="slider-track"
        class="absolute left-0 right-0 flex flex-col"
      >
        {extendedProjects.map((project: any, i: number) => {
          const isCloneFirst = i === 0;
          const isCloneLast  = i === extendedProjects.length - 1;
          const realIndex = isCloneFirst
            ? allSlides.length - 1
            : isCloneLast
              ? 0
              : i - 1;

          return (
            <div
              class="slider-slide w-full shrink-0 flex items-center px-10"
              data-real-index={realIndex}
              data-virtual-index={i}
            >
              {project.thumbnailUrl ? (
                <img
                  src={project.thumbnailUrl}
                  alt={project.name ?? ''}
                  class="w-full object-cover block"
                  style="aspect-ratio: 5/7;"
                  loading={i <= 2 ? 'eager' : 'lazy'}
                  draggable="false"
                />
              ) : project.muxID ? (
                <div class="w-full flex items-center justify-center" style="aspect-ratio: 5/7;">
                  <div class="w-full" style="aspect-ratio: 16/9;">
                    <MuxPlayer
                      playbackId={project.muxID}
                      streamType="on-demand"
                      loop={true}
                      muted={true}
                      autoplay
                      playsInline
                      style="width: 100%; height: 100%; display: block; --controls: none;"
                    />
                  </div>
                </div>
              ) : (
                <div
                  class="w-full bg-gray-800 block"
                  style="aspect-ratio: 5/7;"
                />
              )}
            </div>
          );
        })}
      </div>

      <div
        id="center-info"
        class="absolute top-1/2 left-0 right-0 flex flex-row justify-between items-start text-white mix-blend-difference uppercase tracking-custom text-sm font-normal pointer-events-none z-10000"
      >
        <div id="center-name" class="leading-[110%]"></div>
        <span id="center-index" class="leading-[110%]"></span>


      </div>
    </div>

    <!-- Mobile single-view overlay -->
    <div
      id="mobile-overlay"
      class="fixed inset-0 z-[10000] bg-black text-white hidden opacity-0 pointer-events-none"
    >
      <div
        id="mobile-overlay-media"
        class="absolute inset-0 overflow-hidden opacity-0"
      >
        <div id="mobile-overlay-track" style="display: flex; height: 100%; will-change: transform;"></div>
      </div>

      <button
        id="mobile-overlay-prev-zone"
        class="absolute top-0 bottom-0 left-0 w-1/2 z-20 bg-transparent appearance-none border-0 outline-none"
        aria-label="Previous image"
      ></button>
      <button
        id="mobile-overlay-next-zone"
        class="absolute top-0 bottom-0 right-0 w-1/2 z-20 bg-transparent appearance-none border-0 outline-none"
        aria-label="Next image"
      ></button>

      <button
        id="mobile-overlay-close"
        class="absolute top-8 left-2 z-30 uppercase tracking-custom text-sm font-normal opacity-100 cursor-pointer bg-transparent appearance-none border-0 outline-none"
      >Exit</button>

      <div
        id="mobile-overlay-meta-left"
        class="absolute bottom-padding left-2 z-30 flex flex-col items-start uppercase tracking-custom text-sm font-normal pointer-events-none leading-[110%]"
      >
        <span id="mobile-overlay-index" class="opacity-50"></span>
        <span id="mobile-overlay-name"></span>
      </div>

      <div
        id="mobile-overlay-meta-right"
        class="absolute bottom-padding right-2 z-30 uppercase tracking-custom text-sm font-normal pointer-events-none leading-[110%]"
      >
        <span id="mobile-overlay-counter"></span>
      </div>

      <!-- Mux custom controls (visible only on mobile-overlay videos) -->
      <div
        id="mobile-overlay-mux-controls"
        class="absolute bottom-0 left-0 right-0 z-40 px-padding py-padding flex flex-row justify-between items-center gap-4 text-white mix-blend-difference text-sm uppercase tracking-custom font-normal opacity-0 pointer-events-none transition-opacity duration-200"
        style="visibility: hidden;"
      >
        <div class="flex flex-row gap-4 pointer-events-auto items-center">
          <span data-mux-ctl="playpause" class="cursor-pointer">PLAY</span>
          <span data-mux-ctl="mute" class="cursor-pointer">UNMUTE</span>
        </div>

        <div data-mux-ctl="timeline" class="flex-1 relative h-3 cursor-pointer pointer-events-auto select-none touch-none">
          <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-px bg-white"></div>
          <div data-mux-ctl="thumb" class="absolute top-1/2 -translate-x-1/2 -translate-y-1/2 w-[5px] h-[5px] rounded-full bg-white" style="left: 0%"></div>
        </div>

        <span class="inline-flex gap-1 tabular-nums">
          <span data-mux-ctl="current">00:00</span><span>/</span><span data-mux-ctl="duration">00:00</span>
        </span>

        <span data-mux-ctl="fullscreen" class="cursor-pointer pointer-events-auto">FULLSCREEN</span>
      </div>
    </div>
  </div>

</Layout>

<!-- Pass project data to client -->
<script define:vars={{ projectsWithUrls, ROW_SIZE, headshotSrc: headshot.src }}>
  window.__PROJECTS_DATA__   = projectsWithUrls;
  window.__ROW_SIZE__        = ROW_SIZE;
  window.__MOBILE_PROJECTS__ = [...projectsWithUrls, {
    _id: '__info__',
    name: null,
    type: null,
    index: 0,
    thumbnailUrl: headshotSrc,
    galleryUrls: [],
  }];
</script>

<script>
  import gsap from 'gsap';

  // Each script gates init on initial breakpoint and never re-runs the other
  // path — reload on crossover so the matching gallery initialises cleanly.
  matchMedia('(min-width: 768px)').addEventListener('change', () => {
    location.reload();
  });

  // Only initialise the desktop gallery at md+ breakpoint (≥768px).
  // The mobile slider lives in a separate <script> block below.
  if (matchMedia('(min-width: 768px)').matches) {

  // ─── Constants ─────────────────────────────────────────────────────────────
  const FALLOFF = 0.8;
  const ITEM_GAP_PX = 8;
  const DURATION = 0.5;
  const DURATION_ALT = 0.5;
  const EASE = 'power3.out';
  const COVER_DURATION = 1;
  const COVER_STAGGER_WINDOW = 1;
  const COVER_STAGGER_EASE = 'power1.out';
  const FLIP_DURATION = 0.6;
  const SETTLE_DURATION = 0.6;

  const MOVE_DURATION = 0.8;
  const MOVE_DELAY = 0.6;

  const VERTICAL_THRESHOLD = 0.9;
  const INTENSITY_MULTIPLIER = 0.8;
  const CURVE_POWER = 1.2;

  // Helper to get theme-aware muted opacity
  function getMutedOpacity(): number {
    return document.documentElement.classList.contains('dark') ? 0.2 : 0.3;
  }

  // ─── Performance Utilities ─────────────────────────────────────────────────
  function throttleRAF<T extends (...args: any[]) => void>(fn: T): T {
    let rafId: number | null = null;
    let lastArgs: Parameters<T> | null = null;

    const throttled = (...args: Parameters<T>) => {
      lastArgs = args;
      if (rafId === null) {
        rafId = requestAnimationFrame(() => {
          rafId = null;
          if (lastArgs) fn(...lastArgs);
        });
      }
    };

    return throttled as T;
  }

  // ─── DOM Elements ──────────────────────────────────────────────────────────
  const container = document.getElementById('gallery-container')!;
  const projectDetail = document.getElementById('project-detail')!;
  const projectListContainer = document.getElementById('project-list-container')!;
  const detailImageGallery = document.getElementById('detail-image-gallery');

  if (!container || !projectDetail || !detailImageGallery) {
    console.error('Missing essential DOM elements');
  } else {

  const allWrappers = [...container.querySelectorAll<HTMLElement>('.gallery-row-wrapper')];
  const allRows = [...container.querySelectorAll<HTMLElement>('.gallery-row')];
  const allItems = [...container.querySelectorAll<HTMLElement>('.gallery-item')];

  // ─── State ─────────────────────────────────────────────────────────────────
  let activeRowIndex: number = -1;
  let isProjectOpen = false;
  let isAnimating = false;
  let currentProjectId: string | null = null;
  let clickedRowIndex: number = -1;
  let savedMaxDelta: number = 0;

  const fadedEdge = new Map<HTMLElement, HTMLElement[] | null>();
  let lastMouseX = 0;
  let lastMouseY = 0;

  // ─── Cached Data ───────────────────────────────────────────────────────────
  // Per-row / per-item caches (built once)
  const rowItemsCache = new Map<HTMLElement, HTMLElement[]>();
  const itemAspectsCache = new Map<HTMLElement, number>();
  const rowAspectsCache = new Map<HTMLElement, number[]>();
  const rowIndexCache = new Map<HTMLElement, number>();
  const itemGlobalIndexCache = new Map<HTMLElement, number>();
  const itemRowCache = new Map<HTMLElement, number>();

  // QuickTo setters — drastically faster than creating gsap.to() tweens every frame
  type QuickToFunc = ReturnType<typeof gsap.quickTo>;
  const itemFlexQuickTo = new Map<HTMLElement, QuickToFunc>();
  const wrapperYQuickTo = new Map<HTMLElement, QuickToFunc>();

  // Track wrapper y values ourselves to avoid gsap.getProperty() in the hover loop
  const wrapperYValues = new Map<HTMLElement, number>();

  // Per-row max-delta cache (only changes on resize)
  let cachedMaxDeltas: number[] = [];

  // Pre-build per-row / per-item caches and quickTo setters
  allRows.forEach((row, i) => {
    const items = [...row.querySelectorAll<HTMLElement>('.gallery-item')];
    rowItemsCache.set(row, items);
    rowIndexCache.set(row, i);

    const aspects: number[] = [];
    for (const item of items) {
      const a = parseFloat(item.dataset.aspect || '1');
      itemAspectsCache.set(item, a);
      aspects.push(a);
      itemGlobalIndexCache.set(item, parseInt(item.dataset.globalIndex || '0'));
      itemRowCache.set(item, parseInt(item.dataset.row || '0'));
      itemFlexQuickTo.set(item, gsap.quickTo(item, 'flexGrow', { duration: DURATION_ALT, ease: EASE }));
    }
    rowAspectsCache.set(row, aspects);
  });

  for (const wrp of allWrappers) {
    wrapperYQuickTo.set(wrp, gsap.quickTo(wrp, 'y', { duration: DURATION, ease: EASE }));
    wrapperYValues.set(wrp, 0);
  }

  // Cache preview elements for sidebar
  const previewCache = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('#detail-preview-grid [data-preview-id]').forEach(el => {
    const id = el.dataset.previewId;
    if (id) previewCache.set(id, el);
  });

  // Cache sidebar list items once (was being re-queried on every project switch)
  const detailListItemsCache = [...document.querySelectorAll<HTMLElement>('.detail-list-item')];

  // Reusable buffers to avoid per-frame allocations in the hover hot path
  const weightsBuffer: number[] = [];
  const altWeightsBuffer: number[] = [];

  // ─── Wrapper Y helpers (keep cache + animation in sync) ────────────────────
  function setWrapperYAnimated(wrp: HTMLElement, y: number) {
    wrapperYValues.set(wrp, y);
    const setter = wrapperYQuickTo.get(wrp);
    if (setter) setter(y);
  }

  function setWrapperYInstant(wrp: HTMLElement, y: number) {
    wrapperYValues.set(wrp, y);
    gsap.set(wrp, { y });
  }

  function getWrapperY(wrp: HTMLElement): number {
    return wrapperYValues.get(wrp) ?? 0;
  }

  // Get project data from window
  const projectsData = (window as any).__PROJECTS_DATA__ as any[] || [];
  const ROW_SIZE = (window as any).__ROW_SIZE__ as number || 5;

  // ─── Project Detail Functions ──────────────────────────────────────────────

  function getProjectById(id: string) {
    return projectsData.find(p => p._id === id);
  }

  function populateProjectDetail(project: any) {
    // Clear existing gallery
    detailImageGallery!.innerHTML = '';

    // Build first slot
    const firstSlot = document.createElement('div');
    firstSlot.className = 'col-span-1 w-full overflow-visible';
    firstSlot.id = 'detail-first-image';

    if (project.muxID && !project.thumbnailUrl) {
      firstSlot.innerHTML = `
        <mux-player
          playback-id="${project.muxID}"
          class="w-full object-cover aspect-video"
          style="--controls: none"
          muted
          loop
          data-flip-id="media-${project._id}"
        ></mux-player>
      `;
    } else if (project.thumbnailUrl) {
      firstSlot.innerHTML = `
        <img
          src="${project.thumbnailUrl}"
          alt="${project.name}"
          class="w-full h-full object-cover"
          style="aspect-ratio: 5/7"
          data-flip-id="media-${project._id}"
        />
      `;
    }
    detailImageGallery!.appendChild(firstSlot);

    // Batch-append gallery slots via DocumentFragment (single reflow)
    if (project.galleryUrls && project.galleryUrls.length > 0) {
      const fragment = document.createDocumentFragment();
      for (const img of project.galleryUrls) {
        const slot = document.createElement('div');
        slot.className = 'col-span-1 w-full overflow-hidden relative';
        slot.innerHTML = `
          <img
            src="${img.url}"
            alt="${project.name}"
            class="w-full h-full object-cover"
            style="aspect-ratio: 5/7"
          />
          <div class="gallery-image-cover absolute -inset-1 bg-theme z-10 pointer-events-none"></div>
        `;
        fragment.appendChild(slot);
      }
      detailImageGallery!.appendChild(fragment);
    }

    // Update active state in sidebar list (use cached node list)
    const muted = getMutedOpacity();
    for (const item of detailListItemsCache) {
      const itemId = item.dataset.projectId;
      gsap.to(item, { opacity: itemId === project._id ? 1 : muted });
    }

    // Single attach call (was called twice; second was a no-op via guard)
    attachDetailGalleryListeners();
  }

  function openProject(projectId: string, clickedItem: HTMLElement) {
    if (isProjectOpen || isAnimating) return;

    const project = getProjectById(projectId);
    if (!project) return;

    isProjectOpen = true;
    isAnimating = true;
    currentProjectId = projectId;
    clickedRowIndex = itemRowCache.get(clickedItem) ?? 0;

    // Populate project detail (but keep it hidden for now)
    populateProjectDetail(project);

    // ═══════════════════════════════════════════════════════════════════════════
        // STAGE 0: Settle hover animations before capturing position
        // ═══════════════════════════════════════════════════════════════════════════
        //
        // Drive the settle through the *existing* quickTo setters rather than
        // creating new tweens with `overwrite: true`. Overwriting kills the
        // underlying quickTo tween (its duration becomes 0), and after that
        // calling the setter is a silent no-op — which silently breaks the
        // magnify-on-hover effect for the rows that remain visible below the
        // opened project. Reusing the setters keeps them alive.

        for (const row of allRows) {
          const items = rowItemsCache.get(row) || [];
          for (const item of items) {
            const itemSetter = itemFlexQuickTo.get(item);
            if (itemSetter) itemSetter(1);
          }
        }

        for (const wrapper of allWrappers) {
          wrapperYValues.set(wrapper, 0);
          const wSetter = wrapperYQuickTo.get(wrapper);
          if (wSetter) wSetter(0);
        }

        // Reset hover-state tracking so the post-open hover code starts clean.
        activeRowIndex = -1;

        // The quickTo setters above use DURATION/DURATION_ALT (≤0.5s) so
        // SETTLE_DURATION is plenty of time for them to visually finish before
        // the open animation begins.
        gsap.delayedCall(SETTLE_DURATION, () => {
          startOpenAnimation(projectId, clickedItem, project);
        });
      }

  function startOpenAnimation(projectId: string, clickedItem: HTMLElement, project: any) {
    projectListContainer.style.pointerEvents = 'none';

    const clickedMedia = clickedItem.querySelector('.item-media') as HTMLElement;
    const clickedRect = clickedMedia.getBoundingClientRect();
    const clickedCaption = clickedItem.querySelector('.item-name-type') as HTMLElement;

    if (clickedCaption) clickedCaption.style.visibility = 'hidden';

    const clone = clickedMedia.cloneNode(true) as HTMLElement;
    clone.id = 'transition-clone';
    clone.style.cssText = `
      position: fixed;
      top: ${clickedRect.top}px;
      left: ${clickedRect.left}px;
      width: ${clickedRect.width}px;
      height: ${clickedRect.height}px;
      z-index: 9999;
      pointer-events: none;
      object-fit: cover;
    `;
    document.body.appendChild(clone);
    clickedMedia.style.visibility = 'hidden';

    clickedItem.style.pointerEvents = 'none';

    const clickedGlobalIndex = itemGlobalIndexCache.get(clickedItem) ?? 0;

    // Only animate items that are visible in the viewport
    const viewportHeight = window.innerHeight;

    const itemsToHide: { item: HTMLElement; distance: number }[] = [];
    for (const item of allItems) {
      const rect = item.getBoundingClientRect();
      if (rect.bottom > 0 && rect.top < viewportHeight) {
        itemsToHide.push({
          item,
          distance: Math.abs((itemGlobalIndexCache.get(item) ?? 0) - clickedGlobalIndex)
        });
      }
    }
    // Shuffle (preserved from original behaviour)
    itemsToHide.sort(() => Math.random() - 0.5);

    const tl = gsap.timeline();

    // Set all covers to their starting position, collect into an array
    const covers: HTMLElement[] = [];
    for (const { item } of itemsToHide) {
      const cover = item.querySelector('.gallery-item-cover') as HTMLElement;
      if (!cover) continue;
      gsap.set(cover, { y: cover.offsetHeight, immediateRender: true, overwrite: true });
      covers.push(cover);
    }

    // Animate with GSAP's native stagger ease — no manual formula needed
    tl.to(covers, {
      y: 0,
      duration: 1,
      ease: 'power3.out',
      overwrite: 'auto',
      stagger: {
        each: 0.4 / Math.max(covers.length - 1, 1),

      },
    }, 0);

    // ═══════════════════════════════════════════════════════════════════════════
    // STAGE 2: Set up layout and animate clone to target
    // ═══════════════════════════════════════════════════════════════════════════

    tl.call(() => {
      // All rows are always visible below the project view
      for (let i = 0; i < allWrappers.length; i++) {
        allWrappers[i].querySelectorAll('.gallery-item-cover').forEach(cover => {
          gsap.set(cover, { y: '100%' });
        });
      }

      // Use pre-computed deltas
      const deltas = cachedMaxDeltas.filter(d => isFinite(d) && !isNaN(d));
      savedMaxDelta = deltas.length > 0 ? Math.max(...deltas) : 0;

      setWrapperYInstant(container as any, 0); // container isn't a wrapper but harmless to track
      gsap.set(container, { y: 0, marginTop: window.innerHeight * 1.2 });

      container.parentElement?.insertBefore(projectDetail, container);

      gsap.set(projectListContainer, { opacity: 0 });
      projectDetail.classList.remove('hidden');

      window.scrollTo(0, 0);

      void projectDetail.offsetHeight;

      const targetMedia = document.querySelector('#detail-first-image img, #detail-first-image mux-player') as HTMLElement;

      if (targetMedia) {
        const targetRect = targetMedia.getBoundingClientRect();
        targetMedia.style.visibility = 'hidden';

        gsap.to(clone, {
          top: targetRect.top,
          left: targetRect.left,
          width: targetRect.width,
          height: targetRect.height,
          delay: 0.1,
          duration: 1.2,
          ease: "power3.out",
          onComplete: () => {
            clone.remove();
            targetMedia.style.visibility = 'visible';
            // Fade the source gallery item back in so it appears in the gallery below
            gsap.set(clickedMedia, { visibility: 'visible', opacity: 0 });
            gsap.to(clickedMedia, { opacity: 1, duration: 0.6, ease: 'power3.out' });
            if (clickedCaption) {
              gsap.set(clickedCaption, { visibility: 'visible', opacity: 0 });
              gsap.to(clickedCaption, { opacity: 1, duration: 0.6, ease: 'power3.out' });
            }
            clickedItem.style.pointerEvents = '';
          }
        });

        // Reveal gallery images
        const galleryCovers = detailImageGallery!.querySelectorAll('.gallery-image-cover');
        gsap.fromTo(galleryCovers,
          { y: 0 },
          { y: '100%', duration: 1.2, ease: "power3.out", stagger: 0.2, delay: 0.8 }
        );

        for (let i = 0; i < allWrappers.length; i++) {
          allWrappers[i].querySelectorAll('.gallery-item-cover').forEach(cover => {
            gsap.set(cover, { y: '100%' });
          });
        }

        gsap.fromTo(projectListContainer, { opacity: 0 }, {
          opacity: 1, duration: 2, delay: 1.2, ease: "power3.out", onComplete: () => {
            projectListContainer.style.pointerEvents = 'auto';
          }
        });

        isAnimating = false;
        setupScrollObserver();

      } else {
        clone.remove();
        // Restore clicked item in case there was no target media
        gsap.set(clickedMedia, { visibility: 'visible', opacity: 0 });
        gsap.to(clickedMedia, { opacity: 1, duration: 0.6, ease: 'power2.out' });
        if (clickedCaption) {
          gsap.set(clickedCaption, { visibility: 'visible', opacity: 0 });
          gsap.to(clickedCaption, { opacity: 1, duration: 0.6, ease: 'power2.out' });
        }
        clickedItem.style.pointerEvents = '';
        isAnimating = false;
        setupScrollObserver();
      }
    });
  }

  function closeProject(instant = true) {
    if (!isProjectOpen) return;

    const lenis = (window as any).lenis;
    if (lenis) lenis.stop();

    const firstVisibleIndex = 0;
    const firstVisibleWrapper = allWrappers[firstVisibleIndex];

    const anchorRect = firstVisibleWrapper?.getBoundingClientRect();
    const anchorTop = anchorRect?.top ?? 0;

    isProjectOpen = false;
    isAnimating = false;
    currentProjectId = null;

    cleanupScrollObserver();

    // Reset scroll hint
    const scrollHint = document.getElementById('scroll-back-hint') as HTMLElement | null;
    const scrollFill = document.getElementById('scroll-back-fill') as HTMLElement | null;
    if (scrollHint) {
      gsap.set(scrollHint, { opacity: 0 });
      scrollHint.style.transform = 'translateY(0)';
    }
    if (scrollFill) scrollFill.style.clipPath = 'inset(0 100% 0 0)';

    projectDetail.classList.add('hidden');

    container.parentElement?.insertBefore(projectDetail, container.nextSibling);

    const hiddenRowEnd = firstVisibleIndex;

    for (const wrapper of allWrappers) {
      wrapper.style.display = '';
      wrapper.style.visibility = '';
      setWrapperYInstant(wrapper, 0);
    }

    // Reset flexGrow only for previously hidden rows (preserves visible animation state)
    for (let i = 0; i < hiddenRowEnd; i++) {
      const items = rowItemsCache.get(allRows[i]) || [];
      for (const item of items) {
        gsap.set(item, { flexGrow: 1 });
      }
    }

    // Reset all covers instantly
    for (const item of allItems) {
      const cover = item.querySelector('.gallery-item-cover') as HTMLElement;
      if (cover) gsap.set(cover, { y: '100%' });
    }

    gsap.set(container, { marginTop: 0, y: savedMaxDelta + 20 });

    // Reset visibility/pointer-events on items, media, captions
    for (const item of allItems) {
      item.style.visibility = '';
      item.style.pointerEvents = '';
      const media = item.querySelector('.item-media') as HTMLElement;
      if (media) media.style.visibility = '';
      const caption = item.querySelector('.item-name-type') as HTMLElement;
      if (caption) caption.style.visibility = '';
    }

    clickedRowIndex = -1;
    activeRowIndex = -1;

    // Scroll compensation so visible content stays put
    if (firstVisibleWrapper) {
      void firstVisibleWrapper.offsetHeight;
      const newRect = firstVisibleWrapper.getBoundingClientRect();
      const shift = newRect.top - anchorTop;

      if (Math.abs(shift) > 1) {
        window.scrollTo({ top: window.scrollY + shift, behavior: 'instant' as ScrollBehavior });
      }
    }

    if (lenis) {
      requestAnimationFrame(() => {
        lenis.start();
      });
    }
  }

  function transitionToProject(newProjectId: string) {
    if (newProjectId === currentProjectId) return;

    const project = getProjectById(newProjectId);
    if (!project) return;

    currentProjectId = newProjectId;

    gsap.to(detailImageGallery!.children, {
      opacity: 0,
      duration: DURATION_ALT * 0.5,
      ease: EASE,
      onComplete: () => {
        populateProjectDetail(project);

        gsap.fromTo(detailImageGallery!.children,
          { opacity: 0, y: 10 },
          { opacity: 1, y: 0, duration: DURATION, ease: EASE, stagger: 0.03 }
        );
        const galleryCovers = detailImageGallery!.querySelectorAll('.gallery-image-cover');
        gsap.fromTo(galleryCovers,
          { y: 0 },
          { y: '100%', duration: 1, ease: "power3.out ", stagger: 0.2, delay: DURATION / 2 }
        );
      }
    });
  }

  // ─── Scroll Observer ───────────────────────────────────────────────────────

  let scrollObserver: IntersectionObserver | null = null;
  let scrollHandler: (() => void) | null = null;

  function setupScrollObserver() {
    if (scrollObserver) scrollObserver.disconnect();
    if (scrollHandler) window.removeEventListener('scroll', scrollHandler);

    const firstVisibleIndex = 0;
    const firstVisibleWrapper = allWrappers[firstVisibleIndex];

    if (!firstVisibleWrapper) return;

    scrollObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (isProjectOpen && entry.boundingClientRect.top <= 0) {
          closeProject(true);
        }
      }
    }, {
      threshold: [0, 0.1, 0.25, 0.5],
      rootMargin: '0px 0px 0px 0px'
    });

    scrollObserver.observe(firstVisibleWrapper);

    scrollHandler = () => {
      if (!isProjectOpen) return;
      const wrapperRect = firstVisibleWrapper.getBoundingClientRect();
      if (wrapperRect.bottom <= 0) {
        closeProject(true);
        return;
      }
      const scrollFill = document.getElementById('scroll-back-fill') as HTMLElement | null;
      const hintEl     = document.getElementById('scroll-back-hint') as HTMLElement | null;
      const fillStart  = window.innerHeight * 1.25;        // begin once the gallery row enters the viewport
      const fillEnd    = window.innerHeight * -0.1; // complete when it's 10% above the top edge
      const progress   = Math.max(0, Math.min(1, (fillStart - wrapperRect.top) / (fillStart - fillEnd)));

      if (scrollFill) {
        scrollFill.style.clipPath = `inset(0 ${(1 - progress) * 100}% 0 0)`;
      }

      if (hintEl) {
        // Fade in quickly as we enter the zone
        hintEl.style.opacity = String(Math.min(1, progress * 8));

        // Phase 2 (last 30%): slide hint upward so gallery rows peek in from below
        const REVEAL_START = 0.7;
        if (progress > REVEAL_START) {
          const t = (progress - REVEAL_START) / (1 - REVEAL_START);
          hintEl.style.transform = `translateY(${-t * 100}%)`;
        } else {
          hintEl.style.transform = 'translateY(0)';
        }
      }
    };

    window.addEventListener('scroll', scrollHandler, { passive: true });
  }

  function cleanupScrollObserver() {
    if (scrollObserver) {
      scrollObserver.disconnect();
      scrollObserver = null;
    }
    if (scrollHandler) {
      window.removeEventListener('scroll', scrollHandler);
      scrollHandler = null;
    }
  }

  // ─── Event Handlers ────────────────────────────────────────────────────────

  const handleMouseMove = throttleRAF((e: MouseEvent) => {
    lastMouseX = e.clientX;
    lastMouseY = e.clientY;
    updateHoverAtPoint(e.clientX, e.clientY);
  });

  // Gallery item click handlers
  for (const item of allItems) {
    item.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.detail-list-item')) return;

      const projectId = item.dataset.projectId;
      if (!projectId) return;

      if (!isProjectOpen) {
        openProject(projectId, item);
      } else {
        const itemRow = itemRowCache.get(item) ?? 0;
        if (itemRow > clickedRowIndex) {
          closeProject(true);
          setTimeout(() => openProject(projectId, item), 50);
        }
      }
    });
  }

  // Sidebar list click handlers (use cached node list)
  for (const item of detailListItemsCache) {
    item.addEventListener('click', () => {
      const projectId = item.dataset.projectId;
      if (projectId) transitionToProject(projectId);
    });

    item.addEventListener('mouseenter', () => {
      const projectId = item.dataset.projectId;
      if (projectId) showSidebarPreview(projectId, item);
    });
  }

  document.querySelector('.project-list-container')?.addEventListener('mouseleave', hideSidebarPreview);

  // ─── Sidebar Preview Functions ─────────────────────────────────────────────

  let activeSidebarPreviewId: string | null = null;
  let activeSidebarListItem: HTMLElement | null = null;

  function showSidebarPreview(projectId: string, listItem: HTMLElement) {
    if (activeSidebarPreviewId === projectId) return;

    if (activeSidebarListItem && activeSidebarListItem.dataset.projectId !== currentProjectId) {
      gsap.to(activeSidebarListItem, { opacity: getMutedOpacity() });
    }

    if (activeSidebarPreviewId) {
      const prevPreview = previewCache.get(activeSidebarPreviewId);
      if (prevPreview) {
        gsap.to(prevPreview, { opacity: 0, duration: 0.01 });
        const video = prevPreview.querySelector('mux-player') as HTMLElement & { pause: () => void };
        if (video) video.pause();
      }
    }

    activeSidebarPreviewId = projectId;
    activeSidebarListItem = listItem;

    gsap.to(listItem, { opacity: 1, duration: 0.4, ease: EASE });

    const newPreview = previewCache.get(projectId);
    if (newPreview) {
      gsap.to(newPreview, { opacity: 1, duration: 0.01 });
      const video = newPreview.querySelector('mux-player') as HTMLElement & { play: () => void };
      if (video) video.play();
    }
  }

  function hideSidebarPreview() {
    if (activeSidebarListItem && activeSidebarListItem.dataset.projectId !== currentProjectId) {
      gsap.to(activeSidebarListItem, { opacity: getMutedOpacity() });
    }
    activeSidebarListItem = null;

    if (activeSidebarPreviewId) {
      const prevPreview = previewCache.get(activeSidebarPreviewId);
      if (prevPreview) {
        gsap.to(prevPreview, { opacity: 0 });
        const video = prevPreview.querySelector('mux-player') as HTMLElement & { pause: () => void };
        if (video) video.pause();
      }
    }
    activeSidebarPreviewId = null;
  }

  // ─── Hover Logic ───────────────────────────────────────────────────────────

  window.addEventListener('mousemove', handleMouseMove);

  const handleScroll = throttleRAF(() => {
    if (lastMouseX === 0 && lastMouseY === 0) return;
    updateHoverAtPoint(lastMouseX, lastMouseY);
  });
  window.addEventListener('scroll', handleScroll, { passive: true });

  function resetAll() {
    if (activeRowIndex === -1) return;

    const firstVisibleIndex = 0;

    for (let i = 0; i < allRows.length; i++) {
      if (isProjectOpen && i < firstVisibleIndex) continue;
      resetRow(allRows[i]);
    }
    activeRowIndex = -1;

    for (let i = 0; i < allWrappers.length; i++) {
      if (isProjectOpen && i < firstVisibleIndex) continue;
      const wrp = allWrappers[i];
      if (Math.abs(getWrapperY(wrp)) > 0.5) {
        setWrapperYAnimated(wrp, 0);
      }
    }
  }

  function updateHoverAtPoint(clientX: number, clientY: number) {
    if (allRows.length === 0 || isAnimating) return;

    const cRect = container.getBoundingClientRect();

    if (clientX < cRect.left - 20 || clientX > cRect.right + 20) {
      resetAll();
      return;
    }

    // Compute first visible index once
    const firstVisibleIndex = 0;

    if (isProjectOpen && clickedRowIndex >= 0) {
      const firstVisibleWrapper = allWrappers[firstVisibleIndex];
      if (firstVisibleWrapper) {
        const visibleTop = firstVisibleWrapper.getBoundingClientRect().top;
        const visibleBottom = allWrappers[allWrappers.length - 1].getBoundingClientRect().bottom;

        if (clientY < visibleTop - 40 || clientY > visibleBottom + 40) {
          resetAll();
          return;
        }
      }
    }

    let hoveredIndex = -1;
    let minDistance = Infinity;
    let closestIndex = -1;

    for (let i = 0; i < allRows.length; i++) {
      if (isProjectOpen && i < firstVisibleIndex) continue;

      const row = allRows[i];
      const rect = row.getBoundingClientRect();

      if (clientY >= rect.top && clientY <= rect.bottom) {
        hoveredIndex = i;
      }

      let dist = 0;
      if (clientY < rect.top) dist = rect.top - clientY;
      else if (clientY > rect.bottom) dist = clientY - rect.bottom;

      if (dist < minDistance) {
        minDistance = dist;
        closestIndex = i;
      }
    }

    const targetRowIndex = hoveredIndex !== -1 ? hoveredIndex : closestIndex;

    if (targetRowIndex === -1 || (isProjectOpen && targetRowIndex < firstVisibleIndex)) {
      resetAll();
      return;
    }

    if (hoveredIndex === -1 && minDistance > 100) {
      resetAll();
      return;
    }

    const firstWrapper = allWrappers[firstVisibleIndex];
    const lastWrapper = allWrappers[allWrappers.length - 1];

    if (!firstWrapper) {
      resetAll();
      return;
    }

    // Use cached y values instead of gsap.getProperty()
    const firstWrapperY = getWrapperY(firstWrapper);
    const lastWrapperY = getWrapperY(lastWrapper);
    const staticTopBounds = firstWrapper.getBoundingClientRect().top - firstWrapperY;
    const staticBottomBounds = lastWrapper.getBoundingClientRect().bottom - lastWrapperY;
    const visualTop = allRows[firstVisibleIndex].getBoundingClientRect().top;
    const visualBottom = allRows[allRows.length - 1].getBoundingClientRect().bottom;

    const effectiveTop = Math.min(visualTop, staticTopBounds);
    const effectiveBottom = Math.max(visualBottom, staticBottomBounds);

    if (clientY < effectiveTop - 40 || clientY > effectiveBottom + 40) {
      resetAll();
      return;
    }

    const targetRow = allRows[targetRowIndex];
    const items = rowItemsCache.get(targetRow) || [];
    const n = items.length;

    const wrapper = allWrappers[targetRowIndex];
    const currentY = getWrapperY(wrapper);
    const staticTop = wrapper.getBoundingClientRect().top - currentY;
    const staticHeight = wrapper.offsetHeight;

    let cursorYNorm = (clientY - staticTop) / staticHeight;
    cursorYNorm = Math.max(0, Math.min(1, cursorYNorm));

    // Vertical bleed factors
    let verticalFactor = 0;
    if (cursorYNorm > VERTICAL_THRESHOLD) {
      const progress = (cursorYNorm - VERTICAL_THRESHOLD) / (1 - VERTICAL_THRESHOLD);
      verticalFactor = Math.min(1, Math.pow(progress, CURVE_POWER) * INTENSITY_MULTIPLIER);
    }

    let aboveVerticalFactor = 0;
    const ABOVE_THRESHOLD = 0.05;
    if (cursorYNorm < ABOVE_THRESHOLD) {
      const progress = (ABOVE_THRESHOLD - cursorYNorm) / ABOVE_THRESHOLD;
      aboveVerticalFactor = Math.min(1, Math.pow(progress, CURVE_POWER) * INTENSITY_MULTIPLIER);
    }

    const rect = targetRow.getBoundingClientRect();
    const cursorPos = ((clientX - rect.left) / rect.width) * n;

    // Fill weights buffer in place (no allocation)
    weightsBuffer.length = n;
    for (let j = 0; j < n; j++) {
      weightsBuffer[j] = Math.pow(FALLOFF, Math.abs(cursorPos - (j + 0.5)));
    }

    const nextRowIndex = targetRowIndex + 1;
    const hasNextRow = nextRowIndex < allRows.length;

    const prevRowIndex = targetRowIndex - 1;
    const hasPrevRow = prevRowIndex >= firstVisibleIndex;

    // Reset rows that are not target/prev/next
    for (let i = 0; i < allRows.length; i++) {
      if (i !== targetRowIndex && i !== nextRowIndex && i !== prevRowIndex) {
        resetRow(allRows[i]);
      }
      gsap.set(allRows[i], {
        zIndex: (i === targetRowIndex || i === nextRowIndex || i === prevRowIndex) ? 10 : 'auto'
      });
    }

    animateItems(targetRow, weightsBuffer);
    updateEdgeFade(targetRow, clientX, n);

    if (hasNextRow) {
      altWeightsBuffer.length = n;
      for (let j = 0; j < n; j++) {
        altWeightsBuffer[j] = 1 + (weightsBuffer[j] - 1) * verticalFactor;
      }
      animateItems(allRows[nextRowIndex], altWeightsBuffer);
    }

    if (hasPrevRow) {
      // Reuse altWeightsBuffer for prev row (sequential, not concurrent)
      altWeightsBuffer.length = n;
      for (let j = 0; j < n; j++) {
        altWeightsBuffer[j] = 1 + (weightsBuffer[j] - 1) * aboveVerticalFactor;
      }
      animateItems(allRows[prevRowIndex], altWeightsBuffer);
    }

    const activeDelta = cachedMaxDeltas[targetRowIndex] ?? 0;
    const belowDelta = hasNextRow ? (cachedMaxDeltas[nextRowIndex] ?? 0) * verticalFactor : 0;
    const aboveDelta = hasPrevRow ? (cachedMaxDeltas[prevRowIndex] ?? 0) * aboveVerticalFactor : 0;

    // Animate wrapper y (using cached y + quickTo)
    for (let i = 0; i < allWrappers.length; i++) {
      const wrp = allWrappers[i];

      let yPush = 0;

      if (i < targetRowIndex) {
        yPush = -activeDelta;
        if (i < prevRowIndex) {
          yPush = -aboveDelta - activeDelta;
        }
      } else if (i === targetRowIndex) {
        yPush = -belowDelta;
      }

      const cur = getWrapperY(wrp);
      if (Math.abs(cur - yPush) > 0.5) {
        setWrapperYAnimated(wrp, yPush);
      }
    }

    activeRowIndex = targetRowIndex;
  }

  function getAspects(row: HTMLElement): number[] {
    return rowAspectsCache.get(row) || [];
  }

  function calcBaseHeight(rowIndex: number): number {
    const width = allWrappers[rowIndex].getBoundingClientRect().width;
    const aspects = getAspects(allRows[rowIndex]);
    const n = aspects.length;
    const available = width - (n - 1) * ITEM_GAP_PX;
    const baseW = available / n;
    let max = 0;
    for (let j = 0; j < n; j++) {
      const v = baseW * aspects[j];
      if (v > max) max = v;
    }
    return max;
  }

  function calcMaxDelta(rowIndex: number): number {
    const width = allWrappers[rowIndex].getBoundingClientRect().width;
    const aspects = getAspects(allRows[rowIndex]);
    const n = aspects.length;
    const available = width - (n - 1) * ITEM_GAP_PX;
    const baseH = calcBaseHeight(rowIndex);

    const samplePositions: number[] = [0, n];
    for (let j = 0; j < n; j++) samplePositions.push(j + 0.5);

    let maxDelta = 0;
    const tmpWeights: number[] = new Array(n);

    for (const cursorPos of samplePositions) {
      let sum = 0;
      for (let j = 0; j < n; j++) {
        tmpWeights[j] = Math.pow(FALLOFF, Math.abs(cursorPos - (j + 0.5)));
        sum += tmpWeights[j];
      }
      let maxNewH = 0;
      for (let j = 0; j < n; j++) {
        const v = ((available * tmpWeights[j]) / sum) * aspects[j];
        if (v > maxNewH) maxNewH = v;
      }
      const delta = maxNewH - baseH;
      if (delta > maxDelta) maxDelta = delta;
    }
    return Math.max(0, maxDelta);
  }

  function precomputeMaxDeltas() {
    cachedMaxDeltas = allWrappers.map((_, i) => calcMaxDelta(i));
  }

  function lockHeights() {
    for (const row of allRows) {
      const items = rowItemsCache.get(row) || [];
      for (const item of items) {
        item.style.flexGrow = '1';
      }
    }
    for (let i = 0; i < allRows.length; i++) {
      allWrappers[i].style.height = `${allRows[i].getBoundingClientRect().height}px`;
    }
  }

  function fadeEdge(items: HTMLElement[]) {
    for (const item of items) {
      const overlay = item.querySelector('.title-fade-overlay') as HTMLElement;
      if (overlay) gsap.to(overlay, { opacity: 1, duration: DURATION_ALT, ease: EASE, overwrite: 'auto' });
    }
  }

  function restoreEdge(items: HTMLElement[]) {
    for (const item of items) {
      const overlay = item.querySelector('.title-fade-overlay') as HTMLElement;
      if (overlay) gsap.to(overlay, { opacity: 0, duration: DURATION_ALT, ease: EASE, overwrite: 'auto' });
    }
  }

  function updateEdgeFade(row: HTMLElement, clientX: number, n: number) {
    const items = rowItemsCache.get(row) || [];
    const previousFadedItems = fadedEdge.get(row) ?? [];

    const rect = row.getBoundingClientRect();
    const isLeftHalf = (clientX - rect.left) < rect.width / 2;

    const currentTargetItems: HTMLElement[] = isLeftHalf
      ? [items[n - 1], items[n - 2]].filter(Boolean)
      : [items[0], items[1]].filter(Boolean);

    let isChanged = currentTargetItems.length !== previousFadedItems.length;
    if (!isChanged) {
      for (let i = 0; i < currentTargetItems.length; i++) {
        if (currentTargetItems[i] !== previousFadedItems[i]) { isChanged = true; break; }
      }
    }

    if (isChanged) {
      if (previousFadedItems.length > 0) restoreEdge(previousFadedItems);
      if (currentTargetItems.length > 0) fadeEdge(currentTargetItems);
      fadedEdge.set(row, currentTargetItems);
    }
  }

  function clearEdgeFade(row: HTMLElement) {
    const faded = fadedEdge.get(row);
    if (faded) {
      restoreEdge(faded);
      fadedEdge.set(row, null);
    }
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // SINGLE VIEW OVERLAY LOGIC
  // ═══════════════════════════════════════════════════════════════════════════

  let overlayState: {
    isOpen: boolean;
    projectId: string | null;
    currentIndex: number;
    mediaItems: any[];
  } = {
    isOpen: false,
    projectId: null,
    currentIndex: 0,
    mediaItems: []
  };

  const overlay = document.getElementById('single-view-overlay');
  const overlayMediaContainer = document.getElementById('overlay-media-container');
  const overlayPagination = document.getElementById('overlay-pagination');
  const overlayExit = document.getElementById('overlay-exit');
  const overlayPrev = document.getElementById('overlay-prev');
  const overlayNext = document.getElementById('overlay-next');

  function buildMediaItems(project: any): any[] {
    const items: any[] = [];

    if (project.muxID && !project.thumbnailUrl) {
      items.push({ type: 'video', playbackId: project.muxID, alt: project.name, _key: 'thumbnail' });
    } else if (project.thumbnailUrl) {
      items.push({ type: 'image', url: project.thumbnailUrl, alt: project.name, _key: 'thumbnail' });
    }

    if (project.galleryUrls?.length) {
      for (const img of project.galleryUrls) {
        items.push({ type: 'image', url: img.url, alt: project.name, _key: img._key });
      }
    }

    return items;
  }

  // ─── Custom mux-player controls (single-view overlay) ───────────────────
  type MuxPlayer = HTMLElement & {
    play?: () => Promise<void>;
    pause?: () => void;
    muted: boolean;
    paused: boolean;
    currentTime: number;
    duration: number;
    requestFullscreen?: () => Promise<void>;
  };

  const muxControls       = document.getElementById('overlay-mux-controls');
  const muxControlsHome   = muxControls?.parentElement ?? null; // remember static parent
  const muxPlayPauseEl    = muxControls?.querySelector('[data-mux-ctl="playpause"]')  as HTMLElement | null;
  const muxFullscreenEl   = muxControls?.querySelector('[data-mux-ctl="fullscreen"]') as HTMLElement | null;
  const muxMuteEl         = muxControls?.querySelector('[data-mux-ctl="mute"]')       as HTMLElement | null;
  const muxCurrentEl      = muxControls?.querySelector('[data-mux-ctl="current"]')    as HTMLElement | null;
  const muxDurationEl     = muxControls?.querySelector('[data-mux-ctl="duration"]')   as HTMLElement | null;
  const muxTimelineEl     = muxControls?.querySelector('[data-mux-ctl="timeline"]')   as HTMLElement | null;
  const muxThumbEl        = muxControls?.querySelector('[data-mux-ctl="thumb"]')      as HTMLElement | null;

  let activeMuxPlayer: MuxPlayer | null = null;
  const muxListeners: { [k: string]: (e?: any) => void } = {};

  function fmtTime(s: number): string {
    if (!isFinite(s) || s < 0) return '00:00';
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60);
    return `${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
  }

  function syncMuxUI() {
    if (!activeMuxPlayer) return;
    if (muxPlayPauseEl) muxPlayPauseEl.textContent = activeMuxPlayer.paused ? 'PLAY' : 'PAUSE';
    if (muxMuteEl)      muxMuteEl.textContent      = activeMuxPlayer.muted  ? 'UNMUTE' : 'MUTE';
    const cur = activeMuxPlayer.currentTime || 0;
    const dur = activeMuxPlayer.duration    || 0;
    if (muxCurrentEl)  muxCurrentEl.textContent  = fmtTime(cur);
    if (muxDurationEl) muxDurationEl.textContent = fmtTime(dur);
    const pct = dur > 0 ? Math.max(0, Math.min(100, (cur / dur) * 100)) : 0;
    if (muxThumbEl) muxThumbEl.style.left = `${pct}%`;
  }

  // Pin the controls bar to the active player's bottom edge using fixed
  // positioning. Re-runs on resize and after metadata loads (in case the
  // player resizes when its aspect ratio is known).
  function positionMuxControls() {
    if (!muxControls || !activeMuxPlayer) return;
    const rect = activeMuxPlayer.getBoundingClientRect();
    if (rect.width === 0 || rect.height === 0) {
      requestAnimationFrame(positionMuxControls);
      return;
    }
    muxControls.style.position = 'fixed';
    muxControls.style.top      = '';
    muxControls.style.right    = '';
    muxControls.style.left     = `${rect.left}px`;
    muxControls.style.width    = `${rect.width}px`;
    muxControls.style.bottom   = `${window.innerHeight - rect.bottom}px`;
  }

  const onMuxControlsResize = () => positionMuxControls();

  function attachMuxControls(player: MuxPlayer) {
    detachMuxControls();
    activeMuxPlayer = player;

    muxListeners.play     = () => syncMuxUI();
    muxListeners.pause    = () => syncMuxUI();
    muxListeners.timeupdate     = () => syncMuxUI();
    muxListeners.loadedmetadata = () => { syncMuxUI(); positionMuxControls(); };
    muxListeners.durationchange = () => syncMuxUI();
    muxListeners.volumechange   = () => syncMuxUI();
    for (const ev of Object.keys(muxListeners)) {
      player.addEventListener(ev, muxListeners[ev]);
    }
    syncMuxUI();
    positionMuxControls();
    window.addEventListener('resize', onMuxControlsResize);

    if (muxControls) {
      muxControls.style.opacity    = '1';
      muxControls.style.visibility = 'visible';
    }
  }

  function detachMuxControls() {
    if (activeMuxPlayer) {
      for (const ev of Object.keys(muxListeners)) {
        activeMuxPlayer.removeEventListener(ev, muxListeners[ev]);
      }
    }
    activeMuxPlayer = null;
    window.removeEventListener('resize', onMuxControlsResize);
    if (muxControls) {
      muxControls.style.opacity    = '0';
      muxControls.style.visibility = 'hidden';
      // Clear fixed-position inline styles so a fresh attach starts clean.
      muxControls.style.position = '';
      muxControls.style.top      = '';
      muxControls.style.left     = '';
      muxControls.style.right    = '';
      muxControls.style.bottom   = '';
      muxControls.style.width    = '';
    }
  }

  // Static control handlers — read activeMuxPlayer at click time.
  muxPlayPauseEl?.addEventListener('click', () => {
    if (!activeMuxPlayer) return;
    if (activeMuxPlayer.paused) activeMuxPlayer.play?.().catch(() => {});
    else activeMuxPlayer.pause?.();
  });
  muxFullscreenEl?.addEventListener('click', () => {
    if (!activeMuxPlayer) return;
    if (document.fullscreenElement) document.exitFullscreen();
    else activeMuxPlayer.requestFullscreen?.().catch(() => {});
  });
  muxMuteEl?.addEventListener('click', () => {
    if (!activeMuxPlayer) return;
    activeMuxPlayer.muted = !activeMuxPlayer.muted;
    syncMuxUI();
  });

  // Timeline scrub
  let muxScrubbing = false;
  function seekFromClientX(clientX: number) {
    if (!activeMuxPlayer || !muxTimelineEl) return;
    const rect = muxTimelineEl.getBoundingClientRect();
    const pct  = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
    const dur  = activeMuxPlayer.duration || 0;
    if (dur > 0) {
      activeMuxPlayer.currentTime = pct * dur;
      if (muxThumbEl) muxThumbEl.style.left = `${pct * 100}%`;
    }
  }
  muxTimelineEl?.addEventListener('pointerdown', (e) => {
    muxScrubbing = true;
    seekFromClientX(e.clientX);
    muxTimelineEl.setPointerCapture(e.pointerId);
  });
  muxTimelineEl?.addEventListener('pointermove', (e) => {
    if (muxScrubbing) seekFromClientX(e.clientX);
  });
  muxTimelineEl?.addEventListener('pointerup',     () => { muxScrubbing = false; });
  muxTimelineEl?.addEventListener('pointercancel', () => { muxScrubbing = false; });

  function renderOverlayMedia() {
    if (!overlayMediaContainer) return;

    const item = overlayState.mediaItems[overlayState.currentIndex];
    if (!item) return;

    // Move controls back to their static home BEFORE wiping the container so
    // `innerHTML = ''` doesn't destroy the bar.
    detachMuxControls();
    overlayMediaContainer.innerHTML = '';

    if (item.type === 'video') {
      const player = document.createElement('mux-player') as MuxPlayer;
      player.setAttribute('playback-id', item.playbackId);
      player.className = 'w-full h-auto max-h-screen object-contain block';
      player.setAttribute('loop', '');
      player.setAttribute('muted', '');
      player.setAttribute('playsinline', '');
      player.style.setProperty('--controls', 'none');
      overlayMediaContainer.appendChild(player);

      customElements.whenDefined('mux-player').then(() => {
        player.play?.().catch(() => { /* autoplay blocked */ });
        attachMuxControls(player);
      });
    } else {
      const img = document.createElement('img');
      img.src = item.url;
      img.alt = item.alt || '';
      img.className = 'w-auto h-full max-w-full max-h-screen object-contain';
      img.loading = 'eager';
      overlayMediaContainer.appendChild(img);
    }

    if (overlayPagination) {
      overlayPagination.textContent = `${overlayState.currentIndex + 1}/${overlayState.mediaItems.length}`;
    }

    // Reset inline styles for nav items
    const allNavItems = [overlayExit, overlayPrev, overlayNext, overlayPagination];

    for (const el of allNavItems) {
      if (el) {
        el.style.opacity = '';
        if (el !== overlayPrev && el !== overlayNext) {
          el.style.pointerEvents = 'auto';
        }
      }
    }

    if (overlayPrev) {
      if (overlayState.currentIndex === 0) {
        overlayPrev.classList.remove('opacity-100', 'hover:opacity-muted');
        overlayPrev.classList.add('opacity-muted');
        overlayPrev.style.pointerEvents = 'none';
      } else {
        overlayPrev.classList.remove('opacity-muted');
        overlayPrev.classList.add('opacity-100', 'hover:opacity-muted');
        overlayPrev.style.pointerEvents = 'auto';
      }
    }

    if (overlayNext) {
      if (overlayState.currentIndex === overlayState.mediaItems.length - 1) {
        overlayNext.classList.remove('opacity-100', 'hover:opacity-muted');
        overlayNext.classList.add('opacity-muted');
        overlayNext.style.pointerEvents = 'none';
      } else {
        overlayNext.classList.remove('opacity-muted');
        overlayNext.classList.add('opacity-100', 'hover:opacity-muted');
        overlayNext.style.pointerEvents = 'auto';
      }
    }
  }

  function openOverlay(projectId: string, startIndex = 0) {
    const project = getProjectById(projectId);
    if (!project || !overlay) return;

    document.querySelectorAll<HTMLElement & { pause: () => void }>('mux-player').forEach(player => {
      if (player.pause) player.pause();
    });

    overlayState.projectId = projectId;
    overlayState.mediaItems = buildMediaItems(project);
    overlayState.currentIndex = Math.max(0, Math.min(startIndex, overlayState.mediaItems.length - 1));
    overlayState.isOpen = true;

    document.body.style.overflow = 'hidden';

    overlay.classList.remove('hidden');

    void overlay.offsetHeight;

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.to(overlay, {
      opacity: 1,
      duration: 0.3,
      onStart: () => {
        overlay.style.pointerEvents = 'auto';
      }
    });

    tl.call(() => {
      renderOverlayMedia();
    }, undefined, 0.25)
      .to('#overlay-media-container', {
        delay: 0.5,
        opacity: 1,
        duration: 0.4,
        ease: 'power2.out'
      }, 0.25);
  }

  function closeOverlay() {
    if (!overlayState.isOpen || !overlay) return;

    overlayState.isOpen = false;
    detachMuxControls();

    const tl = gsap.timeline({
      defaults: { ease: 'power3.in' },
      onComplete: () => {
        overlay.classList.add('hidden');
        overlay.style.pointerEvents = 'none';
        if (overlayMediaContainer) overlayMediaContainer.innerHTML = '';
        document.body.style.overflow = '';

        document.querySelectorAll<HTMLElement & { play: () => void }>('.gallery-item mux-player').forEach(player => {
          if (player.play && player.closest('.gallery-item:hover')) {
            player.play();
          }
        });
      }
    });

    const navItems = [overlayExit, overlayPrev, overlayNext, overlayPagination].filter(el => el) as HTMLElement[];

    tl.to(navItems, {
      opacity: 0,
      duration: 0.25,
      stagger: {
        each: 0.05,
        from: 'end',
        ease: 'power2.in'
      },
    });

    tl.to('#overlay-media-container', {
      opacity: 0,
      duration: 0.3
    }, 0.15);

    tl.to(overlay, {
      opacity: 0,
      duration: 0.6,
      ease: 'power2.out'
    });
  }

  function nextMedia() {
    if (overlayState.currentIndex < overlayState.mediaItems.length - 1) {
      overlayState.currentIndex++;
      renderOverlayMedia();
    }
  }

  function prevMedia() {
    if (overlayState.currentIndex > 0) {
      overlayState.currentIndex--;
      renderOverlayMedia();
    }
  }

  if (overlayExit) {
    overlayExit.addEventListener('click', (e) => {
      e.preventDefault();
      closeOverlay();
    });
  }

  if (overlayNext) {
    overlayNext.addEventListener('click', (e) => {
      e.preventDefault();
      nextMedia();
    });
  }

  if (overlayPrev) {
    overlayPrev.addEventListener('click', (e) => {
      e.preventDefault();
      prevMedia();
    });
  }

  document.addEventListener('keydown', (e) => {
    if (!overlayState.isOpen) return;

    if (e.key === 'Escape') {
      e.preventDefault();
      closeOverlay();
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      nextMedia();
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      prevMedia();
    }
  });

  if (overlay) {
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        closeOverlay();
      }
    });
  }

  // ─── Detail Gallery Click Listener (event delegation) ─────────────────────
  let detailGalleryListenerAttached = false;

  function attachDetailGalleryListeners() {
    if (!detailImageGallery || detailGalleryListenerAttached) return;

    detailGalleryListenerAttached = true;

    detailImageGallery.addEventListener('click', (e) => {
      const slot = (e.target as HTMLElement).closest('#detail-first-image, .col-span-1.w-full.overflow-hidden');
      if (!slot) return;

      e.preventDefault();
      e.stopPropagation();

      const projectId = currentProjectId;
      if (!projectId) {
        console.warn('No currentProjectId found');
        return;
      }

      const project = getProjectById(projectId);
      if (!project) return;

      let clickedIndex = 0;
      if (slot.id !== 'detail-first-image') {
        const slots = [...detailImageGallery.querySelectorAll('#detail-first-image, .col-span-1.w-full.overflow-hidden')];
        clickedIndex = Math.max(0, slots.indexOf(slot));
      }

      openOverlay(projectId, clickedIndex);
    });
  }

  function animateItems(row: HTMLElement, weights: number[]) {
    const items = rowItemsCache.get(row) || [];
    const len = Math.min(items.length, weights.length);
    for (let j = 0; j < len; j++) {
      const setter = itemFlexQuickTo.get(items[j]);
      if (setter) setter(weights[j]);
    }
  }

  function resetRow(row: HTMLElement) {
    const items = rowItemsCache.get(row) || [];
    for (const item of items) {
      const setter = itemFlexQuickTo.get(item);
      if (setter) setter(1);
    }
    clearEdgeFade(row);
    gsap.set(row, { zIndex: 'auto' });
  }

  // ─── Init ──────────────────────────────────────────────────────────────────

  function init() {
    try {
      if (allWrappers.length === 0 || allRows.length === 0) {
        console.warn('No gallery rows found');
        return;
      }

      lockHeights();
      precomputeMaxDeltas();

      const deltas = cachedMaxDeltas.filter(d => isFinite(d) && !isNaN(d));
      const maxDelta = deltas.length > 0 ? Math.max(...deltas) : 0;
      gsap.set(container, { y: maxDelta + 20 });

      // Reveal once layout is finalised. Inline visibility/opacity prevent
      // the pre-init "stack of overlapping rows" flash on navigation in.
      container.style.visibility = 'visible';
      gsap.to(container, { opacity: 1, duration: 0.4, ease: 'power2.out' });

      const footer = document.getElementById('desktop-footer');
      if (footer) {
        footer.style.visibility = 'visible';
        gsap.to(footer, { opacity: 1, duration: 0.4, ease: 'power2.out' });
      }

      // Hover-driven video play/pause
      for (const item of allItems) {
        const video = item.querySelector('mux-player') as (HTMLVideoElement & { play: () => void; pause: () => void }) | null;
        if (!video) continue;
        item.addEventListener('mouseenter', () => video.play());
        item.addEventListener('mouseleave', () => video.pause());
      }
    } catch (e) {
      console.error('Error initializing gallery:', e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // Debounced resize handler
  let resizeTimeout: ReturnType<typeof setTimeout> | null = null;
  window.addEventListener('resize', () => {
    if (resizeTimeout) clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
      if (!isProjectOpen) {
        init(); // Re-runs lockHeights + precomputeMaxDeltas
      } else {
        // Just refresh max deltas if a project is open (don't disturb layout)
        precomputeMaxDeltas();
      }
    }, 150);
  });

  // ─── Theme Change Listener ─────────────────────────────────────────────────
  window.addEventListener('themechange', () => {
    const newOpacity = getMutedOpacity();

    for (const item of detailListItemsCache) {
      const itemId = item.dataset.projectId;
      if (itemId !== currentProjectId) {
        gsap.to(item, { opacity: newOpacity });
      }
    }


  });

  } // End of else block for DOM element check

  } // End of `if (matchMedia('(min-width: 768px)').matches)` desktop gate
</script>

<!-- ────────────────────────── Mobile slider script ────────────────────────── -->
<script>
  import gsap from 'gsap';

  // Only run the mobile slider below md breakpoint (<768px).
  if (!matchMedia('(min-width: 768px)').matches) {

  // ── Constants ─────────────────────────────────────────────────────────────
  const SNAP_THRESHOLD = 80;      // px — below this, snap back to current slide
  const SLIDE_DURATION = 0.7;
  const SLIDE_EASE     = 'expo.out';

  // ── DOM refs ──────────────────────────────────────────────────────────────
  const slider        = document.getElementById('mobile-slider')  as HTMLElement;
  const track         = document.getElementById('slider-track')   as HTMLElement;
  const centerInfo    = document.getElementById('center-info')    as HTMLElement;
  const centerNameEl  = document.getElementById('center-name')    as HTMLElement;
  const centerIndexEl = document.getElementById('center-index')   as HTMLElement;

  if (!slider || !track) {
    // Mobile DOM not present (shouldn't happen, but bail gracefully)
  } else {

  const slides = Array.from(
    track.querySelectorAll<HTMLElement>('.slider-slide'),
  );

  const projects: any[] = (window as any).__MOBILE_PROJECTS__ ?? [];
  const n = parseInt(slider.dataset.slideCount ?? '0', 10);

  if (n === 0 && centerInfo) {
    centerInfo.style.display = 'none';
  }

  // ── State ─────────────────────────────────────────────────────────────────
  let currentVirtualIndex = 1;
  let currentTranslateY   = 0;
  let animating           = false;
  let isDragging          = false;
  let startY              = 0;
  let startX              = 0;
  let startTime           = 0;
  let startTranslateY     = 0;

  const TAP_MAX_MOVE = 10;
  const TAP_MAX_TIME = 300;

  function maybeTap(deltaY: number, deltaX: number, elapsed: number): boolean {
    return (
      Math.abs(deltaY) < TAP_MAX_MOVE &&
      Math.abs(deltaX) < TAP_MAX_MOVE &&
      elapsed < TAP_MAX_TIME
    );
  }

  function currentRealIndex(): number {
    const vi = currentVirtualIndex;
    return vi === 0 ? n - 1 : vi === n + 1 ? 0 : vi - 1;
  }

  function sizeSlides(): void {
    const h = slider.offsetHeight;
    for (const slide of slides) slide.style.height = `${h}px`;
  }

  function translateYForVirtual(vi: number): number {
    return -(vi * slider.offsetHeight);
  }

  function updateInfoText(vi: number): void {
    if (n === 0) return;
    const realIdx = vi === 0 ? n - 1 : vi === n + 1 ? 0 : vi - 1;
    const project = projects[realIdx];
    if (!project) return;
    if (project._id === '__info__') {
      centerNameEl.innerHTML =
        '<span style="display:block">Director and Photographer from Toronto.</span>' +
        '<span style="display:block;opacity:0.5">info@justinabernethy.com</span>' +
        '<span style="display:flex;gap:2.5rem;padding-top:4rem;">Instagram<span>Vimeo</span></span>';
      centerIndexEl.textContent = '000';
      return;
    }
    centerNameEl.textContent  = project.name ?? '';
    centerIndexEl.textContent = String(project.index ?? '').padStart(3, '0');
  }

  function goToVirtual(vi: number, animate = true): void {
    if (n === 0) return;
    const targetY = translateYForVirtual(vi);
    updateInfoText(vi);

    if (animate) {
      animating = true;
      currentVirtualIndex = vi;
      gsap.to(track, {
        y: targetY,
        duration: SLIDE_DURATION,
        ease: SLIDE_EASE,
        onComplete() {
          animating         = false;
          currentTranslateY = targetY;
          if (vi === 0)     goToVirtual(n, false);
          if (vi === n + 1) goToVirtual(1, false);
        },
      });
    } else {
      gsap.set(track, { y: targetY });
      currentTranslateY   = targetY;
      currentVirtualIndex = vi;
    }
  }

  // ── Touch events ─────────────────────────────────────────────────────────
  function onTouchStart(e: TouchEvent): void {
    if (n === 0) return;
    startY          = e.touches[0].clientY;
    startX          = e.touches[0].clientX;
    startTime       = performance.now();
    startTranslateY = gsap.getProperty(track, 'y') as number;
    isDragging      = true;
    gsap.killTweensOf(track);
    animating = false;
  }

  function onTouchMove(e: TouchEvent): void {
    if (!isDragging || n === 0) return;
    e.preventDefault();
    gsap.set(track, { y: startTranslateY + (e.touches[0].clientY - startY) });
  }

  function onTouchEnd(e: TouchEvent): void {
    if (!isDragging || n === 0) return;
    isDragging = false;
    const t  = e.changedTouches[0];
    const dy = t.clientY - startY;
    const dx = t.clientX - startX;
    const dt = performance.now() - startTime;

    if (maybeTap(dy, dx, dt)) {
      goToVirtual(currentVirtualIndex);
      openMobileOverlay(currentRealIndex());
      return;
    }

    if      (dy < -SNAP_THRESHOLD) goToVirtual(currentVirtualIndex + 1);
    else if (dy >  SNAP_THRESHOLD) goToVirtual(currentVirtualIndex - 1);
    else                           goToVirtual(currentVirtualIndex);
  }

  slider.addEventListener('touchstart', onTouchStart, { passive: true });
  slider.addEventListener('touchmove',  onTouchMove,  { passive: false });
  slider.addEventListener('touchend',   onTouchEnd,   { passive: true });

  // ── Pointer events (desktop testing) ─────────────────────────────────────
  function onPointerDown(e: PointerEvent): void {
    if (e.pointerType !== 'mouse' || n === 0) return;
    startY          = e.clientY;
    startX          = e.clientX;
    startTime       = performance.now();
    startTranslateY = gsap.getProperty(track, 'y') as number;
    isDragging      = true;
    slider.setPointerCapture(e.pointerId);
    gsap.killTweensOf(track);
    animating = false;
  }

  function onPointerMove(e: PointerEvent): void {
    if (!isDragging || e.pointerType !== 'mouse' || n === 0) return;
    gsap.set(track, { y: startTranslateY + (e.clientY - startY) });
  }

  function onPointerUp(e: PointerEvent): void {
    if (!isDragging || e.pointerType !== 'mouse' || n === 0) return;
    isDragging = false;
    const dy = e.clientY - startY;
    const dx = e.clientX - startX;
    const dt = performance.now() - startTime;

    if (maybeTap(dy, dx, dt)) {
      goToVirtual(currentVirtualIndex);
      openMobileOverlay(currentRealIndex());
      return;
    }

    if      (dy < -SNAP_THRESHOLD) goToVirtual(currentVirtualIndex + 1);
    else if (dy >  SNAP_THRESHOLD) goToVirtual(currentVirtualIndex - 1);
    else                           goToVirtual(currentVirtualIndex);
  }

  function onPointerCancel(e: PointerEvent): void {
    if (!isDragging || e.pointerType !== 'mouse') return;
    isDragging = false;
    goToVirtual(currentVirtualIndex);
  }

  slider.addEventListener('pointerdown',   onPointerDown);
  slider.addEventListener('pointermove',   onPointerMove);
  slider.addEventListener('pointerup',     onPointerUp);
  slider.addEventListener('pointercancel', onPointerCancel);

  // ── Wheel ────────────────────────────────────────────────────────────────
  let wheelAccum = 0;
  let wheelResetTimer: ReturnType<typeof setTimeout> | null = null;
  const WHEEL_THRESHOLD = 50;

  function onWheel(e: WheelEvent): void {
    e.preventDefault();
    if (n === 0) return;

    if (animating) {
      wheelAccum = 0;
      if (wheelResetTimer !== null) { clearTimeout(wheelResetTimer); wheelResetTimer = null; }
      return;
    }

    wheelAccum += e.deltaY;
    if (wheelResetTimer !== null) clearTimeout(wheelResetTimer);
    wheelResetTimer = setTimeout(() => { wheelAccum = 0; }, 200);

    if (Math.abs(wheelAccum) >= WHEEL_THRESHOLD) {
      const dir = wheelAccum > 0 ? 1 : -1;
      wheelAccum = 0;
      if (wheelResetTimer !== null) { clearTimeout(wheelResetTimer); wheelResetTimer = null; }
      goToVirtual(currentVirtualIndex + dir);
    }
  }

  slider.addEventListener('wheel', onWheel, { passive: false });

  // ── Resize ───────────────────────────────────────────────────────────────
  let resizeTimer: ReturnType<typeof setTimeout> | null = null;
  window.addEventListener('resize', () => {
    if (resizeTimer !== null) clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      sizeSlides();
      goToVirtual(currentVirtualIndex, false);
    }, 100);
  });

  // ── Init ─────────────────────────────────────────────────────────────────
  // Sanity returns projects in descending index order, so projects[0] is the
  // highest-numbered (e.g. 025). Start at the first virtual slide; swiping up
  // then steps 025 → 024 → … toward the lowest index.
  function init(): void {
    if (n === 0) return;
    requestAnimationFrame(() => {
      sizeSlides();
      goToVirtual(1, false);
      updateInfoText(1);
    });
  }
  init();

  // Programmatic play (Mux recommends `.play()` over the `autoplay` attribute
  // so we can observe failure via the returned Promise).
  customElements.whenDefined('mux-player').then(() => {
    const players = slider.querySelectorAll<HTMLElement & { play?: () => Promise<void> }>('mux-player');
    for (const p of players) {
      p.play?.().catch(() => { /* autoplay blocked — leave paused */ });
    }
  });

  // ─── Single-view overlay ──────────────────────────────────────────────────
  type OverlayMedia =
    | { type: 'video'; playbackId: string; alt: string }
    | { type: 'image'; url: string;        alt: string };

  const overlayEl       = document.getElementById('mobile-overlay')           as HTMLElement;
  const overlayMediaEl  = document.getElementById('mobile-overlay-media')     as HTMLElement;
  const overlayTrackEl  = document.getElementById('mobile-overlay-track')     as HTMLElement;
  const overlayNameEl   = document.getElementById('mobile-overlay-name')      as HTMLElement;
  const overlayIndexEl  = document.getElementById('mobile-overlay-index')     as HTMLElement;
  const overlayCountEl  = document.getElementById('mobile-overlay-counter')   as HTMLElement;
  const overlayMetaLeft  = document.getElementById('mobile-overlay-meta-left')  as HTMLElement;
  const overlayMetaRight = document.getElementById('mobile-overlay-meta-right') as HTMLElement;
  const overlayPrevZone = document.getElementById('mobile-overlay-prev-zone') as HTMLElement;
  const overlayNextZone = document.getElementById('mobile-overlay-next-zone') as HTMLElement;
  const overlayCloseBtn = document.getElementById('mobile-overlay-close')     as HTMLElement;

  // ── Mux custom controls (mobile project view) ────────────────────────────
  type MobileMuxPlayer = HTMLElement & {
    play?:    () => Promise<void>;
    pause?:   () => void;
    muted:    boolean;
    paused:   boolean;
    currentTime: number;
    duration:    number;
    requestFullscreen?: () => Promise<void>;
  };

  const muxControls    = document.getElementById('mobile-overlay-mux-controls');
  const muxPlayPauseEl  = muxControls?.querySelector('[data-mux-ctl="playpause"]')  as HTMLElement | null;
  const muxMuteEl       = muxControls?.querySelector('[data-mux-ctl="mute"]')       as HTMLElement | null;
  const muxFullscreenEl = muxControls?.querySelector('[data-mux-ctl="fullscreen"]') as HTMLElement | null;
  const muxCurrentEl    = muxControls?.querySelector('[data-mux-ctl="current"]')    as HTMLElement | null;
  const muxDurationEl   = muxControls?.querySelector('[data-mux-ctl="duration"]')   as HTMLElement | null;
  const muxTimelineEl   = muxControls?.querySelector('[data-mux-ctl="timeline"]')   as HTMLElement | null;
  const muxThumbEl      = muxControls?.querySelector('[data-mux-ctl="thumb"]')      as HTMLElement | null;

  let activeMuxPlayer: MobileMuxPlayer | null = null;
  const muxListeners: { [k: string]: (e?: any) => void } = {};

  function fmtTime(s: number): string {
    if (!isFinite(s) || s < 0) return '00:00';
    const m   = Math.floor(s / 60);
    const sec = Math.floor(s % 60);
    return `${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
  }

  function syncMuxUI() {
    if (!activeMuxPlayer) return;
    if (muxPlayPauseEl) muxPlayPauseEl.textContent = activeMuxPlayer.paused ? 'PLAY' : 'PAUSE';
    if (muxMuteEl)      muxMuteEl.textContent      = activeMuxPlayer.muted  ? 'UNMUTE' : 'MUTE';
    const cur = activeMuxPlayer.currentTime || 0;
    const dur = activeMuxPlayer.duration    || 0;
    if (muxCurrentEl)  muxCurrentEl.textContent  = fmtTime(cur);
    if (muxDurationEl) muxDurationEl.textContent = fmtTime(dur);
    const pct = dur > 0 ? Math.max(0, Math.min(100, (cur / dur) * 100)) : 0;
    if (muxThumbEl) muxThumbEl.style.left = `${pct}%`;
  }

  function positionMuxControls() {
    if (!muxControls || !activeMuxPlayer) return;
    const rect = activeMuxPlayer.getBoundingClientRect();
    if (rect.width === 0 || rect.height === 0) {
      requestAnimationFrame(positionMuxControls);
      return;
    }
    muxControls.style.position = 'fixed';
    muxControls.style.top      = '';
    muxControls.style.right    = '';
    muxControls.style.left     = `${rect.left}px`;
    muxControls.style.width    = `${rect.width}px`;
    muxControls.style.bottom   = `${window.innerHeight - rect.bottom}px`;
  }

  const onMuxControlsResize = () => positionMuxControls();

  function attachMuxControls(player: MobileMuxPlayer) {
    detachMuxControls();
    activeMuxPlayer = player;

    muxListeners.play           = () => syncMuxUI();
    muxListeners.pause          = () => syncMuxUI();
    muxListeners.timeupdate     = () => syncMuxUI();
    muxListeners.loadedmetadata = () => { syncMuxUI(); positionMuxControls(); };
    muxListeners.durationchange = () => syncMuxUI();
    muxListeners.volumechange   = () => syncMuxUI();
    for (const ev of Object.keys(muxListeners)) {
      player.addEventListener(ev, muxListeners[ev]);
    }
    syncMuxUI();
    positionMuxControls();
    window.addEventListener('resize', onMuxControlsResize);

    if (muxControls) {
      muxControls.style.opacity    = '1';
      muxControls.style.visibility = 'visible';
    }
    // Hide the static project meta labels — controls take their place.
    if (overlayMetaLeft)  overlayMetaLeft.style.visibility  = 'hidden';
    if (overlayMetaRight) overlayMetaRight.style.visibility = 'hidden';
  }

  function detachMuxControls() {
    if (activeMuxPlayer) {
      for (const ev of Object.keys(muxListeners)) {
        activeMuxPlayer.removeEventListener(ev, muxListeners[ev]);
      }
    }
    activeMuxPlayer = null;
    window.removeEventListener('resize', onMuxControlsResize);
    if (muxControls) {
      muxControls.style.opacity    = '0';
      muxControls.style.visibility = 'hidden';
      muxControls.style.position = '';
      muxControls.style.top      = '';
      muxControls.style.left     = '';
      muxControls.style.right    = '';
      muxControls.style.bottom   = '';
      muxControls.style.width    = '';
    }
    if (overlayMetaLeft)  overlayMetaLeft.style.visibility  = '';
    if (overlayMetaRight) overlayMetaRight.style.visibility = '';
  }

  // Static control handlers — read activeMuxPlayer at click time.
  muxPlayPauseEl?.addEventListener('click', () => {
    if (!activeMuxPlayer) return;
    if (activeMuxPlayer.paused) activeMuxPlayer.play?.().catch(() => {});
    else activeMuxPlayer.pause?.();
  });
  muxMuteEl?.addEventListener('click', () => {
    if (!activeMuxPlayer) return;
    activeMuxPlayer.muted = !activeMuxPlayer.muted;
    syncMuxUI();
  });
  muxFullscreenEl?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (!activeMuxPlayer) return;

    if (document.fullscreenElement) {
      document.exitFullscreen();
      return;
    }

    // Fullscreen the entire mobile overlay rather than the mux-player itself.
    // Reason: when you fullscreen the <mux-player> host element, only that
    // host renders — our sibling controls bar vanishes — and media-chrome's
    // internal fullscreen state machine can race against the request and
    // dispatch an immediate `exitFullscreen()`. Fullscreening the overlay
    // wrapper keeps the player AND controls visible and avoids the race.
    const target: any = overlayEl;
    const reqFs = target?.requestFullscreen?.bind(target)
               // iOS Safari only allows fullscreen on <video>; fall back to
               // mux-player's webkitEnterFullscreen on the underlying video.
               ?? (activeMuxPlayer as any).webkitEnterFullscreen?.bind(activeMuxPlayer);
    reqFs?.()?.catch?.(() => {});
  });

  let muxScrubbing = false;
  function seekFromClientX(clientX: number) {
    if (!activeMuxPlayer || !muxTimelineEl) return;
    const rect = muxTimelineEl.getBoundingClientRect();
    const pct  = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
    const dur  = activeMuxPlayer.duration || 0;
    if (dur > 0) {
      activeMuxPlayer.currentTime = pct * dur;
      if (muxThumbEl) muxThumbEl.style.left = `${pct * 100}%`;
    }
  }
  muxTimelineEl?.addEventListener('pointerdown', (e) => {
    muxScrubbing = true;
    seekFromClientX(e.clientX);
    muxTimelineEl.setPointerCapture(e.pointerId);
  });
  muxTimelineEl?.addEventListener('pointermove', (e) => {
    if (muxScrubbing) seekFromClientX(e.clientX);
  });
  muxTimelineEl?.addEventListener('pointerup',     () => { muxScrubbing = false; });
  muxTimelineEl?.addEventListener('pointercancel', () => { muxScrubbing = false; });

  let overlayOpen  = false;
  let overlayItems: OverlayMedia[] = [];
  let overlayVirtual = 1; // virtual index into extended track (1 = first real item)

  function buildOverlayItems(project: any): OverlayMedia[] {
    const items: OverlayMedia[] = [];
    if (project.muxID && !project.thumbnailUrl) {
      items.push({ type: 'video', playbackId: project.muxID, alt: project.name ?? '' });
    } else if (project.thumbnailUrl) {
      items.push({ type: 'image', url: project.thumbnailUrl, alt: project.name ?? '' });
    }
    if (Array.isArray(project.galleryUrls)) {
      for (const img of project.galleryUrls) {
        items.push({ type: 'image', url: img.url, alt: project.name ?? '' });
      }
    }
    return items;
  }

  function buildOverlayTrack(): void {
    detachMuxControls();
    overlayTrackEl.innerHTML = '';
    const slideW = overlayMediaEl.offsetWidth;
    const m = overlayItems.length;
    if (m === 0) return;

    // Extended: [clone-of-last, ...real-items, clone-of-first]
    const extended = [overlayItems[m - 1], ...overlayItems, overlayItems[0]];

    extended.forEach((item) => {
      const slide = document.createElement('div');
      slide.style.cssText = `flex: 0 0 ${slideW}px; width: ${slideW}px; height: 100%; display: flex; align-items: center; justify-content: center; padding: var(--spacing-padding, 0.375rem);`;

      if (item.type === 'video') {
        const player = document.createElement('mux-player') as MobileMuxPlayer;
        player.setAttribute('playback-id', item.playbackId);
        player.setAttribute('loop', '');
        player.setAttribute('muted', '');
        player.setAttribute('playsinline', '');
        player.style.setProperty('--controls', 'none');
        player.style.width = '100%';
        player.style.maxHeight = '100%';
        slide.appendChild(player);
      } else {
        const img = document.createElement('img');
        img.src = item.url;
        img.alt = item.alt;
        img.draggable = false;
        img.style.cssText = 'max-width: 100%; max-height: 100%; object-fit: contain; display: block;';
        slide.appendChild(img);
      }

      overlayTrackEl.appendChild(slide);
    });
  }

  let overlayAnimating = false;

  function goToOverlayVirtual(vi: number, animate = true): void {
    const m = overlayItems.length;
    if (m === 0) return;
    const realIdx = vi === 0 ? m - 1 : vi === m + 1 ? 0 : vi - 1;
    overlayVirtual = vi;
    overlayCountEl.textContent = `${realIdx + 1}/${m}`;

    const targetX = -(vi * overlayMediaEl.offsetWidth);

    // Sync mux controls to the newly-visible slide
    const slide = overlayTrackEl.children[vi] as HTMLElement | undefined;
    const video = slide?.querySelector('mux-player') as MobileMuxPlayer | null;
    if (video) {
      customElements.whenDefined('mux-player').then(() => {
        attachMuxControls(video);
        video.play?.().catch(() => {});
      });
    } else {
      detachMuxControls();
    }

    // Pause every video not currently shown
    for (let j = 0; j < overlayTrackEl.children.length; j++) {
      if (j !== vi) {
        const v = (overlayTrackEl.children[j] as HTMLElement).querySelector('mux-player') as MobileMuxPlayer | null;
        v?.pause?.();
      }
    }

    if (animate) {
      overlayAnimating = true;
      gsap.to(overlayTrackEl, {
        x: targetX,
        duration: 0.5,
        ease: 'expo.out',
        onComplete: () => {
          overlayAnimating = false;
          if (vi === 0)     goToOverlayVirtual(m, false);
          if (vi === m + 1) goToOverlayVirtual(1, false);
        },
      });
    } else {
      gsap.set(overlayTrackEl, { x: targetX });
      overlayAnimating = false;
    }
  }

  function openMobileOverlay(realIdx: number): void {
    if (n === 0) return;
    const project = projects[realIdx];
    if (!project) return;
    if (project._id === '__info__') return;

    overlayItems = buildOverlayItems(project);
    if (overlayItems.length === 0) return;

    overlayNameEl.textContent  = project.name ?? '';
    overlayIndexEl.textContent = String(project.index ?? '').padStart(3, '0');

    overlayEl.classList.remove('hidden');
    void overlayEl.offsetHeight;

    overlayVirtual = 1;
    buildOverlayTrack();
    goToOverlayVirtual(1, false);

    overlayOpen = true;
    overlayEl.style.pointerEvents = 'auto';

    gsap.to(overlayEl, { opacity: 1, duration: 0.5, ease: 'power3.out' });
    gsap.fromTo(
      overlayMediaEl,
      { opacity: 0 },
      { opacity: 1, duration: 1, delay: 0.5, ease: 'power3.out' },
    );
  }

  function closeMobileOverlay(): void {
    if (!overlayOpen) return;
    overlayOpen = false;
    detachMuxControls();

    gsap.to(overlayEl, {
      opacity: 0,
      duration: 0.25,
      ease: 'power2.in',
      onComplete() {
        overlayEl.classList.add('hidden');
        overlayEl.style.pointerEvents = 'none';
        overlayTrackEl.innerHTML = '';
      },
    });
  }

  function overlayNext(): void {
    if (!overlayOpen || overlayAnimating) return;
    goToOverlayVirtual(overlayVirtual + 1);
  }

  function overlayPrev(): void {
    if (!overlayOpen || overlayAnimating) return;
    goToOverlayVirtual(overlayVirtual - 1);
  }

  overlayPrevZone.addEventListener('click', (e) => { e.preventDefault(); overlayPrev(); });
  overlayNextZone.addEventListener('click', (e) => { e.preventDefault(); overlayNext(); });
  overlayCloseBtn.addEventListener('click', (e) => { e.preventDefault(); closeMobileOverlay(); });

  document.addEventListener('keydown', (e) => {
    if (!overlayOpen) return;
    if      (e.key === 'Escape')     { e.preventDefault(); closeMobileOverlay(); }
    else if (e.key === 'ArrowRight') { e.preventDefault(); overlayNext();        }
    else if (e.key === 'ArrowLeft')  { e.preventDefault(); overlayPrev();        }
  });

  // ── Drag / swipe for overlay track ───────────────────────────────────────
  let overlayDragging      = false;
  let overlayDragStartX    = 0;
  let overlayDragStartY    = 0;
  let overlayDragStartTX   = 0;
  let overlayDragStartTime = 0;
  const OVERLAY_SNAP_THRESHOLD = 50;
  const OVERLAY_TAP_MAX_MOVE   = 10;
  const OVERLAY_TAP_MAX_TIME   = 250;

  overlayEl.addEventListener('touchstart', (e: TouchEvent) => {
    if (!overlayOpen) return;
    if (muxControls?.contains(e.target as Node)) return;
    overlayDragStartX    = e.touches[0].clientX;
    overlayDragStartY    = e.touches[0].clientY;
    overlayDragStartTime = performance.now();
    overlayDragStartTX   = gsap.getProperty(overlayTrackEl, 'x') as number;
    overlayDragging      = true;
    gsap.killTweensOf(overlayTrackEl);
    overlayAnimating = false;
  }, { passive: true });

  overlayEl.addEventListener('touchmove', (e: TouchEvent) => {
    if (!overlayDragging || !overlayOpen) return;
    const dx = e.touches[0].clientX - overlayDragStartX;
    const dy = e.touches[0].clientY - overlayDragStartY;
    // Only take over once horizontal movement dominates
    if (Math.abs(dx) > Math.abs(dy)) {
      e.preventDefault();
      gsap.set(overlayTrackEl, { x: overlayDragStartTX + dx });
    }
  }, { passive: false });

  overlayEl.addEventListener('touchend', (e: TouchEvent) => {
    if (!overlayDragging || !overlayOpen) return;
    overlayDragging = false;
    if (muxControls?.contains(e.target as Node)) return;
    const dx = e.changedTouches[0].clientX - overlayDragStartX;
    const dy = e.changedTouches[0].clientY - overlayDragStartY;
    const dt = performance.now() - overlayDragStartTime;

    // Tap — let the prev/next zone click handlers handle it
    if (Math.abs(dx) < OVERLAY_TAP_MAX_MOVE && Math.abs(dy) < OVERLAY_TAP_MAX_MOVE && dt < OVERLAY_TAP_MAX_TIME) {
      goToOverlayVirtual(overlayVirtual, true);
      return;
    }

    if (Math.abs(dx) > Math.abs(dy)) {
      if      (dx < -OVERLAY_SNAP_THRESHOLD) goToOverlayVirtual(overlayVirtual + 1);
      else if (dx >  OVERLAY_SNAP_THRESHOLD) goToOverlayVirtual(overlayVirtual - 1);
      else                                   goToOverlayVirtual(overlayVirtual);
    } else {
      goToOverlayVirtual(overlayVirtual);
    }
  }, { passive: true });

  } // End of `if (!slider || !track)` else block

  } // End of `if (!matchMedia('(min-width: 768px)').matches)` mobile gate
</script>

---
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import headshot from "../assets/images/JAFINALHEADSHOT.jpg"
---

<Layout title="Justin Abernethy — Information">
    <div id="mobile-info"class="h-screen md:hidden flex flex-col p-padding text-sm leading-[110%]">
        <div class="h-full flex flex-col grow justify-center">
            <div class="flex flex-row items-start justify-start">
                    <p class="text-nowrap pb-10">
                        Director and Photographer Based in Toronto.<br/><span id="email"class="opacity-muted text-nowrap cursor-pointer">info@justinabernethy.com</span>
                    </p>
                </div>
            <div class="grid grid-cols-10 gap-gutter">
                <div id="footer-button" class="col-span-3 flex flex-row justify-start items-start hover:opacity-muted cursor-pointer">Instagram</div>
                <div id="footer-button" class="col-span-3 flex flex-row justify-start items-start hover:opacity-muted cursor-pointer">Vimeo</div>
            </div>
        </div>
        <div class="col-span-10 flex flex-row justify-end items-end h-full">
            <div class="w-full">
                <Picture src={headshot} alt="Justin Abernethy headshot" class="w-full h-auto"></Picture>
            </div>
        </div>
    </div>

    <div id="desktop-info" class="h-screen min-h-220 hidden md:grid! grid-cols-10! gap-gutter p-padding text-sm leading-[110%]">
        <div class="col-span-5 h-full flex flex-col justify-center">
            <div class="grid w-full grid-cols-5 gap-gutter h-fit">
                <div class="col-span-2! flex flex-row items-start justify-start">
                    <p class="text-nowrap">
                        Director and Photographer Based in Toronto.<br/><span id="email"class="opacity-muted text-nowrap cursor-pointer">info@justinabernethy.com</span>
                    </p>
                </div>
                <div id="footer-button" class="col-span-1 flex flex-row justify-end items-start hover:opacity-muted cursor-pointer">Instagram</div>
                <div id="footer-button" class="col-span-1 flex flex-row justify-end items-start hover:opacity-muted cursor-pointer">Vimeo</div>
            </div>
        </div>
        <div class="col-span-5 flex flex-row justify-end items-end h-full">
            <div class="w-[75%]">
                <Picture src={headshot} alt="Justin Abernethy headshot" class="w-full h-auto"></Picture>
            </div>
        </div>
    </div>
</Layout>
